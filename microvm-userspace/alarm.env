# Arch Linux ARM base for the aarch64 guest builds (the userspace bundle,
# npkwm, the portal and the camera).
#
# Arch Linux ARM keeps no dated archive. The bundle is pinned by its package
# list instead, packages-<bundle>-aarch64.txt: repository, name, version,
# file and sha256 of every package. A rebuild installs exactly those files;
# `ALARM_UPDATE=1` resolves the list anew against the mirror. Every package
# is also checked by pacman against the Arch Linux ARM keyring.
#
# Any mirror serves; the signatures and the pinned sha256 carry the trust.
ALARM_MIRROR="${ALARM_MIRROR:-https://fl.us.mirror.archlinuxarm.org/aarch64}"
ALARM_REPOS="core extra alarm"
# archlinuxarm-keyring, pinned by sha256 and signed by the build key.
ALARM_KEYRING="${ALARM_KEYRING:-archlinuxarm-keyring-20240419-2-any.pkg.tar.xz}"
ALARM_KEYRING_SHA256="${ALARM_KEYRING_SHA256:-3cb36869edfe413672a6e932cc55d7f8386e1a9d3b38663cfb3bc6fe0d146e21}"
# Arch Linux ARM Build System <builder@archlinuxarm.org>.
ALARM_BUILD_KEY="${ALARM_BUILD_KEY:-68B3537F39A313B3E574D06777193F152BDBE6A6}"
ALARM_KEYSERVER="${ALARM_KEYSERVER:-hkps://keyserver.ubuntu.com}"
