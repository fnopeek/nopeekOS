# Pinned Alpine release, shared by every guest build (the userspace bundle
# and the guest compositor). Bump these together and give the reason in the
# commit message. A stable branch does not follow the browser: rebuilding on
# the same branch only brings library patches. Check `librewolf` in the next
# branch's APKINDEX before assuming a rebuild updates it.
ALPINE_BRANCH="${ALPINE_BRANCH:-v3.24}"
ALPINE_VERSION="${ALPINE_VERSION:-3.24.2}"
ALPINE_MINIROOTFS_SHA256="${ALPINE_MINIROOTFS_SHA256:-c5ca053cfe1d85c5b96dff8b9bc57045f7f184a30ffb6b65776409ca90388677}"
