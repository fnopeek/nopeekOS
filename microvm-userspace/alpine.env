# Pinned Alpine base, shared by every guest build (the userspace bundle
# and the guest compositor). Bump these together and give the reason in the
# commit message. Edge, not a stable branch: a stable branch does not follow
# the browser (v3.24 stayed on a LibreWolf six releases behind), and base
# and browser must come from one branch. The minirootfs is pinned by date and
# hash; `apk upgrade` brings it to the edge index at build time, and the
# exact package versions are recorded in packages.txt next to this file.
ALPINE_BRANCH="${ALPINE_BRANCH:-edge}"
ALPINE_VERSION="${ALPINE_VERSION:-20260805}"
ALPINE_MINIROOTFS_SHA256="${ALPINE_MINIROOTFS_SHA256:-5acac12c425a0817c1b6a79bdd5df4c73756fc8dc268eab32f8ba830872b835d}"
