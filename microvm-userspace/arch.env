# Pinned Arch Linux base, shared by every guest build (the userspace
# bundle, npkwm, Mesa and iHD). Bump ARCH_SNAPSHOT to take newer packages
# and give the reason in the commit message.
#
# The bootstrap tarball only seeds pacman; every package comes from the
# Arch Linux Archive snapshot of ARCH_SNAPSHOT, so a rebuild with the same
# pin installs the same versions. They are recorded in packages-<bundle>.txt
# next to this file.
ARCH_SNAPSHOT="${ARCH_SNAPSHOT:-2026/10/29}"
ARCH_BOOTSTRAP="${ARCH_BOOTSTRAP:-2026.10.01}"
ARCH_BOOTSTRAP_SHA256="${ARCH_BOOTSTRAP_SHA256:-0c9c97b7a58a8a023c9e07f84cb307a9e8006e65d8fc4c17b83ddc8010b45c10}"
# Arch's release signing key (Pierre Schmitz), found through WKD.
ARCH_RELEASE_KEY="${ARCH_RELEASE_KEY:-3E80CA1A8B89F69CBA57D98A76A5EF9054449A5C}"
