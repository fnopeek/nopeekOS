# nopeek microvm Linux — config overlay on top of x86_64_defconfig.
#
# Goal: minimal Linux that boots in our hypervisor (no ACPI; I/O APIC
# + x2APIC from the MP table, virtio-pci with MSI-X) AND has all
# the virtio drivers we need BUILT-IN (so our raw-syscall PID-1
# doesn't need a module loader).
#
# Applied via `scripts/kconfig/merge_config.sh` after `make
# x86_64_defconfig`. Only put OVERRIDES here — anything we don't
# explicitly mention keeps the defconfig default.

# ── Identity ───────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-nopeek"
# CONFIG_LOCALVERSION_AUTO is not set

# ── Compression ───────────────────────────────────────────────────
# lz4: the bzImage unpacks itself on every launch, before the first
# console line; lz4 inflates several times faster than gzip.
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set
CONFIG_KERNEL_LZ4=y
# CONFIG_KERNEL_ZSTD is not set

# ── virtio: ALL built-in ───────────────────────────────────────────
# This is the whole point — virtio_blk must be in the bzImage so the
# raw-syscall PID-1 can use /dev/vda without modprobe.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
# Not emulated by the host.
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_MMIO is not set

# ── virtio-sound (audio bridge → host audio mailbox → audio_hda) ───
# SND_VIRTIO is the guest sound driver for our virtio-snd device
# (slot 7). It selects SND_PCM + SND_JACK; SND needs SOUND. The guest
# then exposes an ALSA PCM device that PipeWire/ALSA (and thus
# LibreWolf) plays into — our host device forwards the PCM to the
# kernel audio mailbox → audio_hda → speaker.
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCM=y
CONFIG_SND_JACK=y
CONFIG_SND_VIRTIO=y

# ── Input subsystem (Phase 12.4c) ─────────────────────────────────
# evdev gives us /dev/input/eventN char devices that PID-1 (and later
# Firefox via libinput / wayland-libinput) reads to consume events
# from virtio-input. Without INPUT_EVDEV=y the virtio-input driver
# binds but no userspace-visible device node appears.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# ── virtio-gpu (Phase 12.4) ───────────────────────────────────────
# DRM stack + virtio-gpu driver. npkwm drives the output through KMS;
# nothing uses a framebuffer console or /dev/fb0, and switching the
# console onto it costs ~20 ms per launch.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FB is not set
# DRM_VIRTIO_GPU_KMS = 2D scanout / modesetting compiled in. Without
# this, virtgpu_kms.c sets num_scanouts=0 + logs "KMS disabled" and
# /dev/fb0 never appears even with FBDEV_EMULATION on. (Not to be
# confused with virgl/3D which would be DRM_VIRTIO_GPU_VIRGL.)
CONFIG_DRM_VIRTIO_GPU_KMS=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set

# ── Console ────────────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# ── PCI ───────────────────────────────────────────────────────────
CONFIG_PCI=y
# MSI-X: virtio-net signals its queues by message (no INTx, no ISR read
# per interrupt), delivered straight to the target vCPU's LAPIC.
CONFIG_PCI_MSI=y

# ── Memory ────────────────────────────────────────────────────────
# THP: the host backs guest RAM in 2 MB blocks (fault-around); huge pages
# in the guest cut its TLB misses and shootdowns to match.
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_TRANSPARENT_HUGEPAGE_ALWAYS=y

# ── Hardware this VM does not have (defconfig builds them in) ─────
# CONFIG_E100 is not set
# CONFIG_E1000 is not set
# CONFIG_E1000E is not set
# CONFIG_SKY2 is not set
# No i8042 either — virtio-input is the keyboard.
# CONFIG_SERIO_I8042 is not set

# ── Filesystems ───────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# squashfs: the userspace bundle (Mesa/cage/LibreWolf, ~500 MB) ships
# as a read-only .sqfs on a second virtio-blk device (/dev/vdb).
# PID-1 mounts it + pivot_roots into it. lz4 is what the bundle ships
# in (fastest to inflate); zstd and zlib still mount.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
# One decompressor per CPU: the bundle is read by several threads at
# once (PID-1's prefetch, the app's processes); a single one serializes
# them.
# CONFIG_SQUASHFS_COMPILE_DECOMP_SINGLE is not set
CONFIG_SQUASHFS_COMPILE_DECOMP_MULTI_PERCPU=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_SQUASHFS_LZ4=y

# ── initramfs ─────────────────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── Network (minimal — exercise later in 12.3) ────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
# Raw packet sockets: nothing here uses them, and inside a user namespace
# they are attack surface.
# CONFIG_PACKET is not set
# IP_PNP (cmdline `ip=...`) hängt offenbar in unserer microvm-env auch
# mit autoconf=none — wahrscheinlich wartet ic_open_devs auf
# netif_carrier_ok das wir nicht zuverlässig fire'n. Wir bringen eth0
# selbst per syscall im PID-1 hoch (SIOCSIFADDR/SIOCSIFFLAGS).
# CONFIG_IP_PNP is not set

# ── Drop hardware we definitely don't have in the MicroVM ─────────
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is enabled above (virtio-snd audio bridge) — do NOT disable here.
# CONFIG_HID is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set

# ── ACPI off (we don't emulate ACPI tables) ──────────────────────
# defconfig has CONFIG_ACPI=y; cmdline `acpi=off` disables it at runtime
# but the code still gets compiled in. Stripping it shrinks the kernel
# noticeably. Only safe because we're a controlled microvm guest.
# CONFIG_ACPI is not set

# ── SMP — guest multi-vCPU (Stage 1.5) ───────────────────────────
# Re-enabled now that the local APIC + its timer are trap-emulated
# (svm::lapic) and verified by Linux — so the SMP kernel runs in its
# NORMAL config (LAPIC present + per-CPU LAPIC-timer clockevent), not the
# fragile SMP-without-APIC half-state that livelocked userspace in 1a.
# Still booted maxcpus=1 (no AP yet); MP-table enumeration is Stage 2.
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_MPPARSE=y

# ── Drop crypto/security overhead we don't need in a microvm guest ─
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_INTEGRITY is not set
# CONFIG_LANDLOCK is not set

# ── App sandbox ─────────────────────────────────────────────────
# The app runs as an unprivileged user; Firefox's and Chromium's
# sandboxes need user namespaces to isolate their content processes.
CONFIG_USER_NS=y

# ── Boot time ──────────────────────────────────────────────────────
# Each walks or tests something on every launch for tens of ms.
# CONFIG_DEBUG_WX is not set
# CONFIG_CRYPTO_SELFTESTS is not set

# ── Hardening ──────────────────────────────────────────────────────
# The app's processes are the attacker here; user namespaces stay on
# for its sandbox, so what a namespace can reach is kept small.
CONFIG_HARDENED_USERCOPY=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_PANIC_ON_OOPS=y
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_RANDOMIZE_BASE=y

# Not used by the guest; each one is a way for root, or a sandboxed
# process, into the guest kernel.
# CONFIG_MODULES is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_BINFMT_MISC is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_IO_URING needs EXPERT to be switched off.
CONFIG_EXPERT=y
# CONFIG_IO_URING is not set
# CONFIG_IA32_EMULATION is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_NETFILTER is not set
# CONFIG_NFS_FS is not set
# CONFIG_SUNRPC is not set
# CONFIG_NETCONSOLE is not set
# CONFIG_MD is not set
# CONFIG_ATA is not set
# CONFIG_SCSI is not set
# CONFIG_AGP is not set
# CONFIG_DRM_I915 is not set
# CONFIG_ETHERNET is not set
# CONFIG_PCCARD is not set
# CONFIG_INTEL_MEI is not set
# CONFIG_I2C is not set
# CONFIG_KEYBOARD_ATKBD is not set
# CONFIG_INPUT_MOUSE is not set
