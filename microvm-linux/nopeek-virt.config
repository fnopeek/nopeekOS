# nopeek microvm Linux — config overlay on top of x86_64_defconfig.
#
# Goal: minimal Linux that boots in our hypervisor (no ACPI, no APIC,
# no PCI MSI, just 8250 serial + virtio-pci legacy IRQ) AND has all
# the virtio drivers we need BUILT-IN (so our raw-syscall PID-1
# doesn't need a module loader).
#
# Applied via `scripts/kconfig/merge_config.sh` after `make
# x86_64_defconfig`. Only put OVERRIDES here — anything we don't
# explicitly mention keeps the defconfig default.

# ── Identity ───────────────────────────────────────────────────────
CONFIG_LOCALVERSION="-nopeek"
# CONFIG_LOCALVERSION_AUTO is not set

# ── Compression ───────────────────────────────────────────────────
# Stick with gzip — small, fast decompress.
CONFIG_KERNEL_GZIP=y
# CONFIG_KERNEL_LZMA is not set
# CONFIG_KERNEL_XZ is not set
# CONFIG_KERNEL_LZO is not set
# CONFIG_KERNEL_LZ4 is not set
# CONFIG_KERNEL_ZSTD is not set

# ── virtio: ALL built-in ───────────────────────────────────────────
# This is the whole point — virtio_blk must be in the bzImage so the
# raw-syscall PID-1 can use /dev/vda without modprobe.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_PCI_LEGACY=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_MMIO=y

# ── Input subsystem (Phase 12.4c) ─────────────────────────────────
# evdev gives us /dev/input/eventN char devices that PID-1 (and later
# Firefox via libinput / wayland-libinput) reads to consume events
# from virtio-input. Without INPUT_EVDEV=y the virtio-input driver
# binds but no userspace-visible device node appears.
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# ── virtio-gpu (Phase 12.4) ───────────────────────────────────────
# DRM stack + virtio-gpu driver + fbdev emulation so /dev/fb0 falls
# out of the active scanout. PID-1 writes pixels there via raw
# write(); under the hood the DRM layer transfers to host via
# TRANSFER_TO_HOST_2D + RESOURCE_FLUSH which our hypervisor traps.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
# DRM_VIRTIO_GPU_KMS = 2D scanout / modesetting compiled in. Without
# this, virtgpu_kms.c sets num_scanouts=0 + logs "KMS disabled" and
# /dev/fb0 never appears even with FBDEV_EMULATION on. (Not to be
# confused with virgl/3D which would be DRM_VIRTIO_GPU_VIRGL.)
CONFIG_DRM_VIRTIO_GPU_KMS=y
# Disable old fbdev drivers we definitely don't need
# CONFIG_FB_VESA is not set
# CONFIG_FB_EFI is not set
# fbcon attached → first vt-init triggers the initial modeset on us
# (SET_SCANOUT). Without it, drm_fb_helper never set_par's the crtc
# and Linux fbdev writes go to RAM only. Cheap insurance.
CONFIG_FRAMEBUFFER_CONSOLE=y

# ── Console ────────────────────────────────────────────────────────
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_PRINTK=y
CONFIG_PRINTK_TIME=y

# ── PCI ───────────────────────────────────────────────────────────
CONFIG_PCI=y
# We don't emulate MSI/MSI-X yet (12.2.3+). Legacy INTx only.
# CONFIG_PCI_MSI is not set

# ── Filesystems ───────────────────────────────────────────────────
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# squashfs: the userspace bundle (Mesa/cage/LibreWolf, ~500 MB) ships
# as a read-only .sqfs on a second virtio-blk device (/dev/vdb).
# PID-1 mounts it + pivot_roots into it. zstd for big-bundle ratio +
# fast decompress; zlib too since mksquashfs defaults to gzip.
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_FILE_DIRECT=y
CONFIG_SQUASHFS_DECOMP_SINGLE=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_ZSTD=y

# ── initramfs ─────────────────────────────────────────────────────
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y

# ── Network (minimal — exercise later in 12.3) ────────────────────
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
# IP_PNP (cmdline `ip=...`) hängt offenbar in unserer microvm-env auch
# mit autoconf=none — wahrscheinlich wartet ic_open_devs auf
# netif_carrier_ok das wir nicht zuverlässig fire'n. Wir bringen eth0
# selbst per syscall im PID-1 hoch (SIOCSIFADDR/SIOCSIFFLAGS).
# CONFIG_IP_PNP is not set

# ── Drop hardware we definitely don't have in the MicroVM ─────────
# CONFIG_USB_SUPPORT is not set
# CONFIG_SOUND is not set
# CONFIG_HID is not set
# CONFIG_INPUT_MOUSEDEV is not set
# CONFIG_INPUT_KEYBOARD is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
# CONFIG_WIRELESS is not set
# CONFIG_RFKILL is not set
# CONFIG_THERMAL is not set
# CONFIG_WATCHDOG is not set

# ── ACPI off (we don't emulate ACPI tables) ──────────────────────
# defconfig has CONFIG_ACPI=y; cmdline `acpi=off` disables it at runtime
# but the code still gets compiled in. Stripping it shrinks the kernel
# noticeably. Only safe because we're a controlled microvm guest.
# CONFIG_ACPI is not set

# ── SMP — guest multi-vCPU (Stage 1.5) ───────────────────────────
# Re-enabled now that the local APIC + its timer are trap-emulated
# (svm::lapic) and verified by Linux — so the SMP kernel runs in its
# NORMAL config (LAPIC present + per-CPU LAPIC-timer clockevent), not the
# fragile SMP-without-APIC half-state that livelocked userspace in 1a.
# Still booted maxcpus=1 (no AP yet); MP-table enumeration is Stage 2.
CONFIG_SMP=y
CONFIG_NR_CPUS=8
CONFIG_X86_LOCAL_APIC=y
CONFIG_X86_MPPARSE=y

# ── Drop crypto/security overhead we don't need in a microvm guest ─
# CONFIG_AUDIT is not set
# CONFIG_SECURITY is not set
# CONFIG_INTEGRITY is not set
# CONFIG_LANDLOCK is not set
