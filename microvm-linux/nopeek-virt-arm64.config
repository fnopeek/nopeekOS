# nopeek microvm Linux, arm64 overlay.
#
# Merged after `make ARCH=arm64 defconfig` and after nopeek-virt.config
# (with its x86 symbols dropped by build.sh). Only arm64 overrides here.
#
# Guest platform: device tree only (no ACPI, no UEFI), RAM at guest
# physical 0, GICv2, architected timer (virtual), PSCI 1.0 over hvc, a
# 16550 UART over MMIO, pci-host-ecam-generic with preassigned BARs and
# INTx, virtio-pci modern devices.

# ── CPU and memory ────────────────────────────────────────────────
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM64_VA_BITS_48=y
# CONFIG_NUMA is not set
# CONFIG_NUMA_BALANCING is not set
# 32-bit EL0 is attack surface nothing in the guest uses.
# CONFIG_COMPAT is not set
CONFIG_RELOCATABLE=y
CONFIG_RANDOMIZE_BASE=y

# ── Firmware interfaces the guest does not have ───────────────────
# CONFIG_EFI is not set
# CONFIG_ARM_SCMI_PROTOCOL is not set
# CONFIG_ARM_SCPI_PROTOCOL is not set
# CONFIG_CPU_FREQ is not set
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set

# ── Interrupts, timer, power ──────────────────────────────────────
CONFIG_ARM_GIC=y
CONFIG_ARM_ARCH_TIMER=y
CONFIG_ARM_PSCI_FW=y

# ── Console ───────────────────────────────────────────────────────
# 16550 over MMIO from the device tree (ns16550a), named ttyS0.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y
# CONFIG_SERIAL_8250_DW is not set
# CONFIG_SERIAL_8250_EM is not set
# CONFIG_SERIAL_8250_OMAP is not set
# CONFIG_SERIAL_8250_MT6577 is not set
# CONFIG_SERIAL_8250_UNIPHIER is not set
# CONFIG_SERIAL_8250_BCM2835AUX is not set
# PL011 (ttyAMA0) for plain QEMU virt runs.
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y

# ── PCI ───────────────────────────────────────────────────────────
CONFIG_PCI=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_PCI_MSI=y
# CONFIG_PCI_ENDPOINT is not set
# CONFIG_PCI_IOV is not set
# CONFIG_PCI_PASID is not set
# CONFIG_PCIEAER is not set
# CONFIG_PCI_HOST_THUNDER_PEM is not set
# CONFIG_PCI_HOST_THUNDER_ECAM is not set
# CONFIG_PCIE_ALTERA is not set

# ── virtio, as on x86 plus 9p ─────────────────────────────────────
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_PAGE_REPORTING=y
CONFIG_SND_VIRTIO=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
CONFIG_NET_9P=y
CONFIG_NET_9P_VIRTIO=y
CONFIG_9P_FS=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_NETDEVICES=y

# ── SoC platforms: the guest is none of them ──────────────────────
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
