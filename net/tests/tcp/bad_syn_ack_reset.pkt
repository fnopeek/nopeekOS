// #75: a SYN-ACK that acknowledges something we never sent is answered with
// <SEQ=SEG.ACK><CTL=RST>, and we go on waiting for the right one.
0      connect 192.0.2.2:80
+0     > S 0:0(0) <mss 1460,sackOK,nop,nop,TS val ? ecr 0,nop,wscale 8,eol>
+0.01  < S. 0:0(0) ack 5000 win 4000 <mss 1460>
+0     > R 5000:5000(0)
+0     state SYN_SENT
+0.01  < S. 0:0(0) ack 1 win 4000 <mss 1460>
+0     > . 1:1(0) ack 1
+0     status 1
