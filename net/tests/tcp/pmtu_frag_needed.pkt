// Fragmentation Needed for a segment in flight: the MSS follows the new
// path MTU (1000 - 40 - 12 = 948) and every segment larger than that goes
// out again, cut to the MSS, the rest joined with what follows
// (tcp_v4_mtu_reduced, tcp_simple_retransmit, tcp_retrans_try_collapse).
0      connect 192.0.2.2:80
+0     > S 0:0(0) <mss 1460,sackOK,nop,nop,TS val ? ecr 0,nop,wscale 8,eol>
+0.01  < S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
+0     > . 1:1(0) ack 1

+0     send 3000
+0     > P. 1:1449(1448) ack 1
+0     > P. 1449:2897(1448) ack 1
+0     > P. 2897:3001(104) ack 1
+0.01  < icmp 3 4 mtu 1000 seq 1
+0     > P. 1:949(948) ack 1
+0     > P. 949:1449(500) ack 1
+0     > P. 1449:2397(948) ack 1
+0     > P. 2397:3001(604) ack 1
// A lower MTU than the floor is taken as 552 (ip_rt_min_pmtu): 500 bytes.
+0.01  < icmp 3 4 mtu 300 seq 1
// 949:1449 already fits and is still in flight.
+0     > P. 1:501(500) ack 1
+0     > P. 501:949(448) ack 1
+0     > P. 1449:1949(500) ack 1
+0     > P. 1949:2397(448) ack 1
+0     > P. 2397:2897(500) ack 1
+0     > P. 2897:3001(104) ack 1
