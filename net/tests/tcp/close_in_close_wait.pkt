// #61: the peer closes first; our close() then sends a FIN and waits for its
// ACK in LAST_ACK (tcp_close_state), instead of forgetting the connection.
0      connect 192.0.2.2:80
+0     > S 0:0(0) <mss 1460,sackOK,nop,nop,TS val ? ecr 0,nop,wscale 8,eol>
+0.01  < S. 0:0(0) ack 1 win 4000 <mss 1460>
+0     > . 1:1(0) ack 1 win 65535

+0.1   < F. 1:1(0) ack 1 win 4000
+0     > . 1:1(0) ack 2 win 65535
+0     state CLOSE_WAIT
+0     close
+0     > F. 1:1(0) ack 2 win 65535
+0     state LAST_ACK
+0.01  < . 2:2(0) ack 2 win 4000
+0     state GONE
