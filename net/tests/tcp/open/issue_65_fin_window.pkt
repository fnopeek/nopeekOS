// #65: a FIN advertises the receive window like any other segment
// (RFC 9293 §3.10.4); window 0 would tell the peer to stop sending.
0      connect 192.0.2.2:80
+0     > S 0:0(0) <mss 1460,sackOK,nop,nop,TS val ? ecr 0,nop,wscale 8,eol>
+0.01  < S. 0:0(0) ack 1 win 65535 <mss 1460,sackOK,TS val 100 ecr 0,nop,wscale 7>
+0     > . 1:1(0) ack 1 win 1024

+0     close
+0     > F. 1:1(0) ack 1 win 1024
