# Large OTA assets — distributed via GitHub Releases, NOT main branch.
# `./build.sh release-large <tag>` uploads them and writes the
# resulting URL into release/assets/manifest.large for `release` to
# merge into the canonical asset manifest.
release/assets/large/
release/assets/manifest.large
