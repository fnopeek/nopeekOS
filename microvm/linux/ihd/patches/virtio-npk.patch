     DDI_CHK_NULL(mediaCtx, "nullptr mediaCtx", VA_STATUS_ERROR_INVALID_CONTEXT);
+    // nopeekOS: the reference DdiMedia__Initialize took on the device.
+    int npkFd = mediaCtx->fd;
 
     DdiMediaUtil_LockMutex(&GlobalMutex);
 
@@ -2298,6 +2317,7 @@ VAStatus DdiMedia_Terminate (
     {
         mediaCtx->uiRef--;
         DdiMediaUtil_UnLockMutex(&GlobalMutex);
+        npk_intel_virtio_unref_fd(npkFd);
 
         return VA_STATUS_SUCCESS;
     }
@@ -2311,6 +2331,7 @@ VAStatus DdiMedia_Terminate (
     ctx->pDriverData = nullptr;
 
     DdiMediaUtil_UnLockMutex(&GlobalMutex);
+    npk_intel_virtio_unref_fd(npkFd);
 
     return VA_STATUS_SUCCESS;
 }
