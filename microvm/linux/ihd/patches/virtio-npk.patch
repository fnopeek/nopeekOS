diff --git a/media_softlet/linux/common/os/i915/xf86drm.c b/media_softlet/linux/common/os/i915/xf86drm.c
index 9b2412c..0d17947 100644
--- a/media_softlet/linux/common/os/i915/xf86drm.c
+++ b/media_softlet/linux/common/os/i915/xf86drm.c
@@ -53,6 +53,7 @@
 #include <sys/ioctl.h>
 #include <sys/time.h>
 #include <stdarg.h>
+#include <npk_intel_virtio.h>
 #ifdef HAVE_SYS_MKDEV_H
 # include <sys/mkdev.h> /* defines major(), minor(), and makedev() on Solaris */
 #endif
@@ -162,11 +163,36 @@ void drmFree(void *pt)
 #if defined(__cplusplus)
 extern "C" {
 #endif
+/*
+ * nopeekOS: on a virtio_gpu render node the i915 ioctls, and the generic
+ * ones a GEM driver issues (GEM_CLOSE, FLINK, OPEN, PRIME, SYNCOBJ), go
+ * to Mesa's Intel virtio backend, as iris and anv send them; the rest
+ * (VERSION, GET_CAP, ...) is the virtio_gpu kernel driver's.
+ */
+static int
+npk_virtio_routed(unsigned long request)
+{
+    unsigned int nr = _IOC_NR(request);
+
+    if (nr >= DRM_COMMAND_BASE && nr < DRM_COMMAND_END)
+        return 1;
+    switch (nr) {
+    case 0x09: case 0x0a: case 0x0b:   /* GEM_CLOSE, GEM_FLINK, GEM_OPEN */
+    case 0x2d: case 0x2e:              /* PRIME_HANDLE_TO_FD, PRIME_FD_TO_HANDLE */
+        return 1;
+    default:
+        return nr >= 0xbf && nr <= 0xcd; /* SYNCOBJ_* */
+    }
+}
+
 drm_export int
 mosdrmIoctl(int fd, unsigned long request, void *arg)
 {
     int    ret;
 
+    if (npk_virtio_routed(request) && npk_is_intel_virtio_fd(fd))
+        return npk_intel_virtio_ioctl(fd, request, arg);
+
     do {
     ret = ioctl(fd, request, arg);
     } while (ret == -1 && (errno == EINTR || errno == EAGAIN));
