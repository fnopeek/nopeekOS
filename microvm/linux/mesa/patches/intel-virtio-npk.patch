--- /dev/null
+++ b/src/intel/dev/virtio/npk_intel_virtio.h
@@ -0,0 +1,37 @@
+/*
+ * nopeekOS: libnpk_intel_virtio, the Intel virtio backend for drivers
+ * outside Mesa.
+ * SPDX-License-Identifier: MIT
+ */
+
+#ifndef NPK_INTEL_VIRTIO_H_
+#define NPK_INTEL_VIRTIO_H_
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* 1 when `fd` is a virtio_gpu render node now served by this library, 0
+ * when it is not virtio_gpu, negative on failure. Balanced by unref. */
+int npk_intel_virtio_init_fd(int fd);
+void npk_intel_virtio_ref_fd(int fd);
+void npk_intel_virtio_unref_fd(int fd);
+bool npk_is_intel_virtio_fd(int fd);
+
+/* An i915 ioctl (or GEM_CLOSE, PRIME, SYNCOBJ) on `fd`, retried on EINTR
+ * and EAGAIN; on a fd this library does not serve, the kernel's ioctl. */
+int npk_intel_virtio_ioctl(int fd, unsigned long request, void *arg);
+
+/* The CPU mapping of GEM object `handle`; MAP_FAILED on failure. The
+ * caching mode is the one set with I915_GEM_MMAP_OFFSET. */
+void *npk_intel_virtio_bo_mmap(int fd, uint32_t handle, size_t size);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* NPK_INTEL_VIRTIO_H_ */
