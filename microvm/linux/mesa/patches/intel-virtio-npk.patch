+/* The length of one extension of an engine map, whole. An unknown one is
+ * sent as its header alone; the host refuses it by name. */
+static size_t
+npk_engines_ext_size(const struct i915_user_extension *ext)
+{
+   switch (ext->name) {
+   case I915_CONTEXT_ENGINES_EXT_LOAD_BALANCE: {
+      const struct i915_context_engines_load_balance *lb = (const void *)ext;
+      return sizeof(*lb) + lb->num_siblings * sizeof(lb->engines[0]);
+   }
+   case I915_CONTEXT_ENGINES_EXT_BOND: {
+      const struct i915_context_engines_bond *b = (const void *)ext;
+      return sizeof(*b) + b->num_bonds * sizeof(b->engines[0]);
+   }
+   case I915_CONTEXT_ENGINES_EXT_PARALLEL_SUBMIT: {
+      const struct i915_context_engines_parallel_submit *ps = (const void *)ext;
+      return sizeof(*ps) + ps->width * ps->num_siblings * sizeof(ps->engines[0]);
+   }
+   default:
+      return sizeof(*ext);
+   }
+}
+
+/* i915_user_extensions stops a longer chain with -E2BIG. */
+#define NPK_MAX_EXTENSIONS 513
+
+/* The extension chain of an engine map: its length inline, and whether
+ * there is one. */
+static size_t
+npk_engines_chain_size(const struct drm_i915_gem_context_param *param)
+{
+   const struct i915_context_param_engines *e = (void *)(uintptr_t)param->value;
+   size_t len = 0;
+   unsigned n = 0;
+
+   if (param->param != I915_CONTEXT_PARAM_ENGINES || param->size < sizeof(*e) || !e)
+      return 0;
+
+   for (const struct i915_user_extension *ext = (void *)(uintptr_t)e->extensions;
+        ext && n < NPK_MAX_EXTENSIONS; ext = (void *)(uintptr_t)ext->next_extension, n++)
+      len += npk_engines_ext_size(ext);
+
+   return len;
+}
+
+/* I915_CCMD_NPK_CONTEXT_SETPARAM / _GETPARAM: the parameter's data inline,
+ * an engine map's extension chain after it. */
+static int
+i915_virtio_npk_context_param(struct intel_virtio_device *dev, bool get,
+                              struct drm_i915_gem_context_param *param)
+{
+   void *data = (void *)(uintptr_t)param->value;
+   size_t size = data ? param->size : 0;
+   size_t chain = get ? 0 : npk_engines_chain_size(param);
+   size_t req_len = sizeof(struct i915_ccmd_npk_context_param_req) + size + chain;
+   struct i915_ccmd_npk_context_param_req *req;
+   struct i915_ccmd_npk_context_param_rsp *rsp;
+   int err;
+
+   req = calloc(1, req_len);
+   if (!req)
+      return ENOMEM;
+
+   req->hdr = get ? I915_CCMD(NPK_CONTEXT_GETPARAM, req_len) :
+                    I915_CCMD(NPK_CONTEXT_SETPARAM, req_len);
+   req->ctx_id = param->ctx_id;
+   req->size = param->size;
+   req->param = param->param;
+   req->value = param->value;
+   req->data_len = size + chain;
+   if (size)
+      memcpy(req->payload, data, size);
+
+   if (chain) {
+      const struct i915_context_param_engines *e = data;
+      uint8_t *out = req->payload + size;
+      unsigned n = 0;
+
+      for (const struct i915_user_extension *ext = (void *)(uintptr_t)e->extensions;
+           ext && n < NPK_MAX_EXTENSIONS; ext = (void *)(uintptr_t)ext->next_extension, n++) {
+         size_t len = npk_engines_ext_size(ext);
+         struct i915_user_extension *copy = (void *)out;
+
+         memcpy(out, ext, len);
+         copy->next_extension = ext->next_extension ? 1 : 0;
+         out += len;
+      }
+   }
+
+   rsp = vdrm_alloc_rsp(dev->vdrm, &req->hdr, sizeof(*rsp) + (get ? size : 0));
+
+   err = vdrm_send_req(dev->vdrm, &req->hdr, true);
+   free(req);
+   if (err)
+      return errno;
+
+   if (rsp->ret)
+      return rsp->ret;
+
+   if (get) {
+      if (size)
+         memcpy(data, rsp->payload, MIN2(size, rsp->size));
+      else
+         param->value = rsp->value;
+   }
+   param->size = rsp->size;
+
+   return 0;
+}
