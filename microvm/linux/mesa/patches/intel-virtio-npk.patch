+++ b/src/intel/dev/virtio/npk_intel_virtio.c
@@ -0,0 +1,47 @@
+/*
+ * nopeekOS: the Intel virtio backend for a driver outside Mesa (Intel's
+ * media driver, iHD), which speaks the i915 uAPI on a render node that is
+ * virtio_gpu in the guest. The same calls iris and anv make.
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "intel_virtio_priv.h"
+#include "npk_intel_virtio.h"
+
+#define NPK_EXPORT __attribute__((visibility("default")))
+
+NPK_EXPORT int
+npk_intel_virtio_init_fd(int fd)
+{
+   return intel_virtio_init_fd(fd);
+}
+
+NPK_EXPORT void
+npk_intel_virtio_ref_fd(int fd)
+{
+   intel_virtio_ref_fd(fd);
+}
+
+NPK_EXPORT void
+npk_intel_virtio_unref_fd(int fd)
+{
+   intel_virtio_unref_fd(fd);
+}
+
+NPK_EXPORT bool
+npk_is_intel_virtio_fd(int fd)
+{
+   return is_intel_virtio_fd(fd);
+}
+
+NPK_EXPORT int
+npk_intel_virtio_ioctl(int fd, unsigned long request, void *arg)
+{
+   return intel_ioctl(fd, request, arg);
+}
+
+NPK_EXPORT void *
+npk_intel_virtio_bo_mmap(int fd, uint32_t handle, size_t size)
+{
+   return intel_virtio_bo_mmap(fd, handle, size, NULL);
+}
diff --git a/src/intel/dev/virtio/npk_intel_virtio.h b/src/intel/dev/virtio/npk_intel_virtio.h
new file mode 100644
