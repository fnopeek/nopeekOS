+/* i915_gem_context_create_ioctl with its create_extensions applied one by
+ * one: a bad extension or a refused parameter destroys the context, and
+ * its error is the call's. */
+static int
+i915_virtio_gem_context_create_split(struct intel_virtio_device *dev,
+                                     struct drm_i915_gem_context_create_ext *create)
+{
+   struct drm_i915_gem_context_create bare = {
+      .pad = create->flags & ~I915_CONTEXT_CREATE_FLAGS_USE_EXTENSIONS,
+   };
+   int err;
+
+   err = i915_virtio_simple_ioctl(dev, DRM_IOCTL_I915_GEM_CONTEXT_CREATE, &bare);
+   if (err)
+      return err;
+
+   for (struct drm_i915_gem_context_create_ext_setparam *sp = (void *)(uintptr_t)create->extensions;
+        sp; sp = (void *)(uintptr_t)sp->base.next_extension) {
+      struct drm_i915_gem_context_param p = sp->param;
+      bool mbz = !sp->base.flags;
+
+      for (unsigned i = 0; i < ARRAY_SIZE(sp->base.rsvd); i++)
+         mbz &= !sp->base.rsvd[i];
+
+      if (!mbz || sp->base.name != I915_CONTEXT_CREATE_EXT_SETPARAM || p.ctx_id)
+         err = EINVAL;
+      else {
+         p.ctx_id = bare.ctx_id;
+         err = i915_virtio_npk_context_param(dev, false, &p);
+      }
+      if (err) {
+         struct drm_i915_gem_context_destroy destroy = { .ctx_id = bare.ctx_id };
+         i915_virtio_simple_ioctl(dev, DRM_IOCTL_I915_GEM_CONTEXT_DESTROY, &destroy);
+         return err;
+      }
+   }
+
+   create->ctx_id = bare.ctx_id;
+   return 0;
+}
