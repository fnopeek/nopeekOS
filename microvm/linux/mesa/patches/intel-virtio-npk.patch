+   uint32_t ring;
+   uint64_t ticket;
 };
 
 struct intel_virtio_device *fd_to_intel_virtio_device(int fd);
diff --git a/src/intel/dev/virtio/npk_intel_virtio.c b/src/intel/dev/virtio/npk_intel_virtio.c
