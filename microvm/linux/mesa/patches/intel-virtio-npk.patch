+/* Out-fences that have signalled are of no further use as submit fences. */
+static void
+npk_out_fences_prune(struct intel_virtio_device *dev)
+{
+   struct npk_out_fence *f = util_dynarray_begin(&dev->npk_fences);
+   unsigned n = util_dynarray_num_elements(&dev->npk_fences, struct npk_out_fence);
+
+   for (unsigned i = 0; i < n;) {
+      if (sync_wait(f[i].fd, 0) == 0) {
+         close(f[i].fd);
+         f[i] = f[--n];
+      } else {
+         i++;
+      }
+   }
+   dev->npk_fences.size = n * sizeof(struct npk_out_fence);
+}
+
+/* The ring and ticket of the execbuffer whose out-fence `fd` is. */
+static bool
+npk_out_fence_lookup(struct intel_virtio_device *dev, int fd,
+                     uint32_t *ring, uint64_t *ticket)
+{
+   util_dynarray_foreach(&dev->npk_fences, struct npk_out_fence, f) {
+      if (os_same_file_description(f->fd, fd) == 0) {
+         *ring = f->ring;
+         *ticket = f->ticket;
+         return true;
+      }
+   }
+   return false;
+}
