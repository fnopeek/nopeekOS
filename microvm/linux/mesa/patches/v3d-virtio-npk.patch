diff --git a/src/broadcom/common/v3d_virtio_proto.h b/src/broadcom/common/v3d_virtio_proto.h
new file mode 100644
index 0000000..2641d7c
--- /dev/null
+++ b/src/broadcom/common/v3d_virtio_proto.h
@@ -0,0 +1,147 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* The V3D virtio-gpu native context wire format: V3D's DRM ioctls sent
+ * as ccmds. All fields are little-endian; every request is a multiple of
+ * 8 bytes. A response starts with its length and a negative errno or 0.
+ */
+
+#ifndef V3D_VIRTIO_PROTO_H
+#define V3D_VIRTIO_PROTO_H
+
+#include <assert.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "virtio/virtio-gpu/drm_hw.h"
+
+enum v3d_ccmd {
+   V3D_CCMD_NOP = 1,
+   V3D_CCMD_CREATE_BO,
+   V3D_CCMD_GET_BO_OFFSET,
+   V3D_CCMD_WAIT_BO,
+   V3D_CCMD_SUBMIT_CL,
+   V3D_CCMD_SUBMIT_TFU,
+   V3D_CCMD_SUBMIT_CSD,
+   V3D_CCMD_GET_PARAM,
+};
+
+/* The ring that submissions run on, in order. */
+#define V3D_VIRTIO_RING_IDX 1
+
+#define V3D_CCMD(_cmd, _len) (struct vdrm_ccmd_req){ \
+      .cmd = V3D_CCMD_##_cmd,                       \
+      .len = (_len),                                \
+   }
+
+struct v3d_shmem {
+   struct vdrm_shmem base;
+
+   /* Submissions the host refused or that failed on the GPU. */
+   uint32_t async_error;
+   uint32_t pad;
+};
+
+struct v3d_ccmd_rsp {
+   struct vdrm_ccmd_rsp hdr;
+   int32_t ret;
+};
+
+/* Sent inside VIRTGPU_RESOURCE_CREATE_BLOB (HOST3D, blob_id). */
+struct v3d_ccmd_create_bo_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t size;
+   uint32_t flags;
+   uint32_t blob_id;
+   uint32_t pad;
+};
+
+struct v3d_ccmd_get_bo_offset_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t res_id;
+   uint32_t pad;
+};
+
+struct v3d_ccmd_get_bo_offset_rsp {
+   struct v3d_ccmd_rsp hdr;
+   uint32_t offset;
+   uint32_t pad;
+};
+
+struct v3d_ccmd_wait_bo_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t res_id;
+   uint32_t pad;
+   uint64_t timeout_ns;
+};
+
+struct v3d_ccmd_submit_cl_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t bcl_start;
+   uint32_t bcl_end;
+   uint32_t rcl_start;
+   uint32_t rcl_end;
+   uint32_t qma;
+   uint32_t qms;
+   uint32_t qts;
+   uint32_t flags;
+   uint32_t nr_res;
+   uint32_t pad;
+   uint32_t res_ids[];
+};
+
+struct v3d_ccmd_submit_tfu_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t icfg;
+   uint32_t iia;
+   uint32_t iis;
+   uint32_t ica;
+   uint32_t iua;
+   uint32_t ioa;
+   uint32_t ios;
+   uint32_t coef[4];
+   uint32_t ioc;
+   /* 0 for none. */
+   uint32_t res_ids[4];
+};
+
+struct v3d_ccmd_submit_csd_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t cfg[7];
+   uint32_t coef[4];
+   uint32_t flags;
+   uint32_t nr_res;
+   uint32_t pad;
+   uint32_t res_ids[];
+};
+
+struct v3d_ccmd_get_param_req {
+   struct vdrm_ccmd_req hdr;
+   uint32_t param;
+   uint32_t pad;
+};
+
+struct v3d_ccmd_get_param_rsp {
+   struct v3d_ccmd_rsp hdr;
+   uint64_t value;
+};
+
+static_assert(sizeof(struct vdrm_ccmd_req) == 16, "ccmd header");
+static_assert(offsetof(struct v3d_shmem, async_error) == 8, "shmem");
+static_assert(sizeof(struct v3d_shmem) == 16, "shmem");
+static_assert(sizeof(struct v3d_ccmd_rsp) == 8, "rsp");
+static_assert(sizeof(struct v3d_ccmd_create_bo_req) == 32, "CREATE_BO");
+static_assert(sizeof(struct v3d_ccmd_get_bo_offset_req) == 24, "GET_BO_OFFSET");
+static_assert(sizeof(struct v3d_ccmd_get_bo_offset_rsp) == 16, "GET_BO_OFFSET");
+static_assert(offsetof(struct v3d_ccmd_wait_bo_req, timeout_ns) == 24, "WAIT_BO");
+static_assert(sizeof(struct v3d_ccmd_wait_bo_req) == 32, "WAIT_BO");
+static_assert(offsetof(struct v3d_ccmd_submit_cl_req, res_ids) == 56, "SUBMIT_CL");
+static_assert(offsetof(struct v3d_ccmd_submit_tfu_req, ioc) == 60, "SUBMIT_TFU");
+static_assert(sizeof(struct v3d_ccmd_submit_tfu_req) == 80, "SUBMIT_TFU");
+static_assert(offsetof(struct v3d_ccmd_submit_csd_req, flags) == 60, "SUBMIT_CSD");
+static_assert(offsetof(struct v3d_ccmd_submit_csd_req, res_ids) == 72, "SUBMIT_CSD");
+static_assert(sizeof(struct v3d_ccmd_get_param_req) == 24, "GET_PARAM");
+static_assert(sizeof(struct v3d_ccmd_get_param_rsp) == 16, "GET_PARAM");
+
+#endif /* V3D_VIRTIO_PROTO_H */
