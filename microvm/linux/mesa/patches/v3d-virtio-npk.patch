+
+/**
+ * Whether virtgpu offers a V3D native context of a V3D this driver knows.
+ */
+bool
+v3d_drm_probe_nctx(int fd, const struct virgl_renderer_capset_drm *caps)
+{
+   if (caps->context_type != VIRTGPU_DRM_CONTEXT_V3D)
+      return false;
+
+   uint32_t major = (caps->u.v3d.core0_ident0 >> 24) & 0xff;
+   uint32_t minor = caps->u.v3d.core0_ident1 & 0xf;
+   uint32_t ver = major * 10 + minor;
+
+   return ver == 42 || ver == 71;
+}
