                                       const struct pipe_screen_config *config,
                                       struct renderonly *ro);
diff --git a/src/gallium/drivers/v3d/v3d_virtio.c b/src/gallium/drivers/v3d/v3d_virtio.c
new file mode 100644
index 0000000..a3bdb0f
--- /dev/null
+++ b/src/gallium/drivers/v3d/v3d_virtio.c
@@ -0,0 +1,631 @@
+/*
+ * SPDX-License-Identifier: MIT
+ */
+
+/* V3D through a virtio-gpu DRM native context: the driver's DRM ioctls
+ * become ccmds (common/v3d_virtio_proto.h). GEM handles stay guest
+ * handles; the host names objects by their resource id. Syncobjs are the
+ * guest's own and travel with the submission's execbuffer.
+ */
+
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xf86drm.h>
+
+#include "common/v3d_virtio_proto.h"
+#include "drm-uapi/v3d_drm.h"
+#include "drm-uapi/virtgpu_drm.h"
+#include "util/log.h"
+#include "util/macros.h"
+#include "util/sparse_array.h"
+#include "util/u_atomic.h"
+#include "util/u_math.h"
+#include "vdrm.h"
+
+#include "v3d_screen.h"
+#include "v3d_virtio.h"
+
+/* What this backend implements of the capset's supports bits. */
+#define V3D_VIRTIO_SUPPORTS (VIRTGPU_V3D_SUPPORTS_TFU |         \
+                             VIRTGPU_V3D_SUPPORTS_CSD |         \
+                             VIRTGPU_V3D_SUPPORTS_CACHE_FLUSH | \
+                             VIRTGPU_V3D_SUPPORTS_SUPER_PAGES)
+
+struct v3d_virtio_handle {
+        uint32_t res_id;
+        /* Seen by another process or device: listed in execbuffers so
+         * the guest kernel fences it (implicit sync).
+         */
+        bool shared;
+};
+
+struct v3d_virtio {
+        struct vdrm_device *vdrm;
+        /* struct v3d_virtio_handle, indexed by GEM handle. */
+        struct util_sparse_array handles;
+        uint32_t next_blob_id;
+        uint32_t async_error;
+};
+
+static int
+fail(int err)
+{
+        errno = err;
+        return -1;
+}
+
+static int
+get_caps(int fd, struct virgl_renderer_capset_drm *caps)
+{
+        struct drm_virtgpu_get_caps args = {
+                .cap_set_id = VIRTGPU_DRM_CAPSET_DRM,
+                .cap_set_ver = 0,
+                .addr = (uintptr_t)caps,
+                .size = sizeof(*caps),
+        };
+
+        memset(caps, 0, sizeof(*caps));
+        return drmIoctl(fd, DRM_IOCTL_VIRTGPU_GET_CAPS, &args);
+}
+
+/* The parameters the capset answers. */
+static bool
+caps_param(const struct virgl_renderer_capset_drm *caps, uint32_t param,
+           uint64_t *value)
+{
+        uint32_t supports = caps->u.v3d.supports & V3D_VIRTIO_SUPPORTS;
+
+        switch (param) {
+        case DRM_V3D_PARAM_V3D_HUB_IDENT1:
+                *value = caps->u.v3d.hub_ident1;
+                return true;
+        case DRM_V3D_PARAM_V3D_HUB_IDENT2:
+                *value = caps->u.v3d.hub_ident2;
+                return true;
+        case DRM_V3D_PARAM_V3D_HUB_IDENT3:
+                *value = caps->u.v3d.hub_ident3;
+                return true;
+        case DRM_V3D_PARAM_V3D_CORE0_IDENT0:
+                *value = caps->u.v3d.core0_ident0;
+                return true;
+        case DRM_V3D_PARAM_V3D_CORE0_IDENT1:
+                *value = caps->u.v3d.core0_ident1;
+                return true;
+        case DRM_V3D_PARAM_V3D_CORE0_IDENT2:
+                *value = caps->u.v3d.core0_ident2;
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_TFU:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_TFU);
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_CSD:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_CSD);
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_CACHE_FLUSH:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_CACHE_FLUSH);
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_PERFMON:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_PERFMON);
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_MULTISYNC_EXT:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_MULTISYNC_EXT);
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_CPU_QUEUE:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_CPU_QUEUE);
+                return true;
+        case DRM_V3D_PARAM_SUPPORTS_SUPER_PAGES:
+                *value = !!(supports & VIRTGPU_V3D_SUPPORTS_SUPER_PAGES);
+                return true;
+        case DRM_V3D_PARAM_MAX_PERF_COUNTERS:
+                /* Counter names come from the kernel only with PERFMON. */
+                *value = (supports & VIRTGPU_V3D_SUPPORTS_PERFMON) ?
+                         caps->u.v3d.max_perf_counters : 0;
+                return true;
+        default:
+                return false;
+        }
+}
+
+static bool
+is_reset_counter(uint32_t param)
+{
+        return param == DRM_V3D_PARAM_GLOBAL_RESET_COUNTER ||
+               param == DRM_V3D_PARAM_CONTEXT_RESET_COUNTER;
+}
+
+bool
+v3d_virtio_is_virtgpu(int fd)
+{
+        drmVersionPtr version = drmGetVersion(fd);
+        if (!version)
+                return false;
+
+        bool ret = strcmp(version->name, "virtio_gpu") == 0;
+        drmFreeVersion(version);
+        return ret;
+}
+
+/* For v3d_get_device_info(), before a screen exists. */
+int
+v3d_virtio_devinfo_ioctl(int fd, unsigned long request, void *arg)
+{
+        struct drm_v3d_get_param *p = arg;
+        struct virgl_renderer_capset_drm caps;
+
+        if (request != DRM_IOCTL_V3D_GET_PARAM)
+                return fail(EINVAL);
+
+        if (get_caps(fd, &caps))
+                return -1;
+        if (caps.context_type != VIRTGPU_DRM_CONTEXT_V3D)
+                return fail(ENODEV);
+
+        uint64_t value;
+        if (caps_param(&caps, p->param, &value)) {
+                p->value = value;
+                return 0;
+        }
+
+        /* Only their presence is asked here; the host counts them. */
+        if (is_reset_counter(p->param)) {
+                p->value = 0;
+                return 0;
+        }
+
+        return fail(EINVAL);
+}
+
+static struct v3d_virtio_handle *
+handle_get(struct v3d_virtio *v, uint32_t handle)
+{
+        struct v3d_virtio_handle *h = util_sparse_array_get(&v->handles, handle);
+
+        if (!h->res_id)
+                h->res_id = vdrm_handle_to_res_id(v->vdrm, handle);
+
+        return h;
+}
+
+static void
+handle_close(struct v3d_virtio *v, uint32_t handle)
+{
+        struct v3d_virtio_handle *h = util_sparse_array_get(&v->handles, handle);
+
+        h->res_id = 0;
+        h->shared = false;
+        vdrm_bo_close(v->vdrm, handle);
+}
+
+static int
+get_bo_offset(struct v3d_virtio *v, uint32_t res_id, uint32_t *offset)
+{
+        struct v3d_ccmd_get_bo_offset_req req = {
+                .hdr = V3D_CCMD(GET_BO_OFFSET, sizeof(req)),
+                .res_id = res_id,
+        };
+        struct v3d_ccmd_get_bo_offset_rsp *rsp =
+                vdrm_alloc_rsp(v->vdrm, &req.hdr, sizeof(*rsp));
+
+        if (vdrm_send_req(v->vdrm, &req.hdr, true))
+                return fail(EIO);
+        if (rsp->hdr.ret)
+                return fail(-rsp->hdr.ret);
+
+        *offset = rsp->offset;
+        return 0;
+}
+
+static int
+virtio_create_bo(struct v3d_virtio *v, struct drm_v3d_create_bo *args)
+{
+        uint32_t blob_id = p_atomic_inc_return(&v->next_blob_id);
+        /* Blob id 0 is the shmem. */
+        if (!blob_id)
+                blob_id = p_atomic_inc_return(&v->next_blob_id);
+
+        struct v3d_ccmd_create_bo_req req = {
+                .hdr = V3D_CCMD(CREATE_BO, sizeof(req)),
+                .size = args->size,
+                .flags = args->flags,
+                .blob_id = blob_id,
+        };
+        uint32_t handle =
+                vdrm_bo_create(v->vdrm, args->size,
+                               VIRTGPU_BLOB_FLAG_USE_MAPPABLE |
+                               VIRTGPU_BLOB_FLAG_USE_SHAREABLE,
+                               blob_id, 0, &req.hdr);
+        if (!handle)
+                return fail(ENOMEM);
+
+        struct v3d_virtio_handle *h = util_sparse_array_get(&v->handles, handle);
+        h->res_id = vdrm_handle_to_res_id(v->vdrm, handle);
+        h->shared = false;
+
+        uint32_t offset;
+        if (!h->res_id || get_bo_offset(v, h->res_id, &offset)) {
+                handle_close(v, handle);
+                return fail(ENOMEM);
+        }
+
+        args->handle = handle;
+        args->offset = offset;
+        return 0;
+}
+
+static int
+virtio_get_bo_offset(struct v3d_virtio *v, struct drm_v3d_get_bo_offset *args)
+{
+        struct v3d_virtio_handle *h = handle_get(v, args->handle);
+        if (!h->res_id)
+                return fail(ENOENT);
+
+        return get_bo_offset(v, h->res_id, &args->offset);
+}
+
+static int
+virtio_wait_bo(struct v3d_virtio *v, struct drm_v3d_wait_bo *args)
+{
+        struct v3d_virtio_handle *h = handle_get(v, args->handle);
+        if (!h->res_id)
+                return fail(ENOENT);
+
+        struct v3d_ccmd_wait_bo_req req = {
+                .hdr = V3D_CCMD(WAIT_BO, sizeof(req)),
+                .res_id = h->res_id,
+                .timeout_ns = args->timeout_ns,
+        };
+        struct v3d_ccmd_rsp *rsp = vdrm_alloc_rsp(v->vdrm, &req.hdr, sizeof(*rsp));
+
+        if (vdrm_send_req(v->vdrm, &req.hdr, true))
+                return fail(EIO);
+        if (rsp->ret)
+                return fail(-rsp->ret);
+
+        return 0;
+}
+
+static int
+virtio_get_param(struct v3d_virtio *v, struct drm_v3d_get_param *args)
+{
+        uint64_t value;
+        if (caps_param(&v->vdrm->caps, args->param, &value)) {
+                args->value = value;
+                return 0;
+        }
+
+        if (!is_reset_counter(args->param))
+                return fail(EINVAL);
+
+        struct v3d_ccmd_get_param_req req = {
+                .hdr = V3D_CCMD(GET_PARAM, sizeof(req)),
+                .param = args->param,
+        };
+        struct v3d_ccmd_get_param_rsp *rsp =
+                vdrm_alloc_rsp(v->vdrm, &req.hdr, sizeof(*rsp));
+
+        if (vdrm_send_req(v->vdrm, &req.hdr, true))
+                return fail(EIO);
+        if (rsp->hdr.ret)
+                return fail(-rsp->hdr.ret);
+
+        args->value = rsp->value;
+        return 0;
+}
+
+static int
+virtio_mmap_bo(struct v3d_screen *screen, struct drm_v3d_mmap_bo *args)
+{
+        struct drm_virtgpu_map map = {
+                .handle = args->handle,
+        };
+
+        if (drmIoctl(screen->fd, DRM_IOCTL_VIRTGPU_MAP, &map))
+                return -1;
+
+        args->offset = map.offset;
+        return 0;
+}
+
+static int
+virtio_prime_import(struct v3d_virtio *v, struct drm_prime_handle *args)
+{
+        uint32_t handle = vdrm_dmabuf_to_handle(v->vdrm, args->fd);
+        if (!handle)
+                return fail(EINVAL);
+
+        handle_get(v, handle)->shared = true;
+        args->handle = handle;
+        return 0;
+}
+
+static int
+virtio_prime_export(struct v3d_virtio *v, struct drm_prime_handle *args)
+{
+        int fd = vdrm_bo_export_dmabuf(v->vdrm, args->handle);
+        if (fd < 0)
+                return fail(EINVAL);
+
+        handle_get(v, args->handle)->shared = true;
+        args->fd = fd;
+        return 0;
+}
+
+static void
+check_async_error(struct v3d_virtio *v)
+{
+        struct v3d_shmem *shmem = (struct v3d_shmem *)v->vdrm->shmem;
+        uint32_t async_error = p_atomic_read(&shmem->async_error);
+
+        if (async_error != v->async_error) {
+                mesa_loge("v3d: the host failed %u submission(s)",
+                          async_error - v->async_error);
+                v->async_error = async_error;
+        }
+}
+
+/* Translates GEM handles to resource ids into res_ids, and collects the
+ * shared ones into guest_handles.
+ */
+static int
+translate_handles(struct v3d_virtio *v, const uint32_t *handles, uint32_t count,
+                  uint32_t *res_ids, uint32_t *guest_handles,
+                  uint32_t *guest_count)
+{
+        *guest_count = 0;
+
+        for (uint32_t i = 0; i < count; i++) {
+                if (!handles[i]) {
+                        res_ids[i] = 0;
+                        continue;
+                }
+
+                struct v3d_virtio_handle *h = handle_get(v, handles[i]);
+                if (!h->res_id)
+                        return fail(ENOENT);
+
+                res_ids[i] = h->res_id;
+                if (h->shared)
+                        guest_handles[(*guest_count)++] = handles[i];
+        }
+
+        return 0;
+}
+
+static int
+execbuf(struct v3d_virtio *v, struct vdrm_ccmd_req *req,
+        uint32_t *guest_handles, uint32_t guest_count,
+        const uint32_t *in_syncs, unsigned in_count, uint32_t out_sync)
+{
+        struct drm_virtgpu_execbuffer_syncobj in[2] = { 0 };
+        struct drm_virtgpu_execbuffer_syncobj out = {
+                .handle = out_sync,
+        };
+        unsigned nr_in = 0;
+
+        assert(in_count <= ARRAY_SIZE(in));
+        for (unsigned i = 0; i < in_count; i++) {
+                bool seen = false;
+                for (unsigned j = 0; j < nr_in; j++)
+                        seen |= in[j].handle == in_syncs[i];
+                if (in_syncs[i] && !seen)
+                        in[nr_in++].handle = in_syncs[i];
+        }
+
+        struct vdrm_execbuf_params p = {
+                .ring_idx = V3D_VIRTIO_RING_IDX,
+                .req = req,
+                .handles = guest_handles,
+                .num_handles = guest_count,
+                .in_syncobjs = nr_in ? in : NULL,
+                .num_in_syncobjs = nr_in,
+                .out_syncobjs = out_sync ? &out : NULL,
+                .num_out_syncobjs = out_sync ? 1 : 0,
+                .fence_fd = -1,
+        };
+
+        int ret = vdrm_execbuf(v->vdrm, &p);
+        check_async_error(v);
+
+        return ret ? fail(EIO) : 0;
+}
+
+static int
+virtio_submit_cl(struct v3d_virtio *v, struct drm_v3d_submit_cl *args)
+{
+        if ((args->flags & DRM_V3D_SUBMIT_EXTENSION) || args->perfmon_id)
+                return fail(EINVAL);
+
+        uint32_t count = args->bo_handle_count;
+        size_t len = align(sizeof(struct v3d_ccmd_submit_cl_req) +
+                           count * sizeof(uint32_t), 8);
+        struct v3d_ccmd_submit_cl_req *req = calloc(1, len);
+        uint32_t *guest_handles = malloc(MAX2(count, 1) * sizeof(uint32_t));
+        uint32_t guest_count;
+        int ret = -1;
+
+        if (!req || !guest_handles) {
+                errno = ENOMEM;
+                goto out;
+        }
+
+        req->hdr = V3D_CCMD(SUBMIT_CL, len);
+        req->bcl_start = args->bcl_start;
+        req->bcl_end = args->bcl_end;
+        req->rcl_start = args->rcl_start;
+        req->rcl_end = args->rcl_end;
+        req->qma = args->qma;
+        req->qms = args->qms;
+        req->qts = args->qts;
+        req->flags = args->flags & DRM_V3D_SUBMIT_CL_FLUSH_CACHE;
+        req->nr_res = count;
+
+        if (translate_handles(v, (const uint32_t *)(uintptr_t)args->bo_handles,
+                              count, req->res_ids, guest_handles, &guest_count))
+                goto out;
+
+        uint32_t in_syncs[] = { args->in_sync_bcl, args->in_sync_rcl };
+        ret = execbuf(v, &req->hdr, guest_handles, guest_count,
+                      in_syncs, ARRAY_SIZE(in_syncs), args->out_sync);
+
+out:
+        free(guest_handles);
+        free(req);
+        return ret;
+}
+
+static int
+virtio_submit_tfu(struct v3d_virtio *v, struct drm_v3d_submit_tfu *args)
+{
+        if (args->flags & DRM_V3D_SUBMIT_EXTENSION)
+                return fail(EINVAL);
+
+        struct v3d_ccmd_submit_tfu_req req = {
+                .hdr = V3D_CCMD(SUBMIT_TFU, sizeof(req)),
+                .icfg = args->icfg,
+                .iia = args->iia,
+                .iis = args->iis,
+                .ica = args->ica,
+                .iua = args->iua,
+                .ioa = args->ioa,
+                .ios = args->ios,
+                .ioc = args->v71.ioc,
+        };
+        memcpy(req.coef, args->coef, sizeof(req.coef));
+
+        uint32_t guest_handles[ARRAY_SIZE(args->bo_handles)];
+        uint32_t guest_count;
+        if (translate_handles(v, args->bo_handles, ARRAY_SIZE(args->bo_handles),
+                              req.res_ids, guest_handles, &guest_count))
+                return -1;
+
+        return execbuf(v, &req.hdr, guest_handles, guest_count,
+                       &args->in_sync, 1, args->out_sync);
+}
+
+static int
+virtio_submit_csd(struct v3d_virtio *v, struct drm_v3d_submit_csd *args)
+{
+        if ((args->flags & DRM_V3D_SUBMIT_EXTENSION) || args->perfmon_id)
+                return fail(EINVAL);
+
+        uint32_t count = args->bo_handle_count;
+        size_t len = align(sizeof(struct v3d_ccmd_submit_csd_req) +
+                           count * sizeof(uint32_t), 8);
+        struct v3d_ccmd_submit_csd_req *req = calloc(1, len);
+        uint32_t *guest_handles = malloc(MAX2(count, 1) * sizeof(uint32_t));
+        uint32_t guest_count;
+        int ret = -1;
+
+        if (!req || !guest_handles) {
+                errno = ENOMEM;
+                goto out;
+        }
+
+        req->hdr = V3D_CCMD(SUBMIT_CSD, len);
+        memcpy(req->cfg, args->cfg, sizeof(req->cfg));
+        memcpy(req->coef, args->coef, sizeof(req->coef));
+        req->flags = args->flags & DRM_V3D_SUBMIT_CL_FLUSH_CACHE;
+        req->nr_res = count;
+
+        if (translate_handles(v, (const uint32_t *)(uintptr_t)args->bo_handles,
+                              count, req->res_ids, guest_handles, &guest_count))
+                goto out;
+
+        ret = execbuf(v, &req->hdr, guest_handles, guest_count,
+                      &args->in_sync, 1, args->out_sync);
+
+out:
+        free(guest_handles);
+        free(req);
+        return ret;
+}
+
+static int
+v3d_virtio_ioctl(struct v3d_screen *screen, unsigned long request, void *arg)
+{
+        struct v3d_virtio *v = screen->virtio;
+
+        switch (request) {
+        case DRM_IOCTL_V3D_CREATE_BO:
+                return virtio_create_bo(v, arg);
+        case DRM_IOCTL_V3D_GET_BO_OFFSET:
+                return virtio_get_bo_offset(v, arg);
+        case DRM_IOCTL_V3D_WAIT_BO:
+                return virtio_wait_bo(v, arg);
+        case DRM_IOCTL_V3D_MMAP_BO:
+                return virtio_mmap_bo(screen, arg);
+        case DRM_IOCTL_V3D_GET_PARAM:
+                return virtio_get_param(v, arg);
+        case DRM_IOCTL_V3D_SUBMIT_CL:
+                return virtio_submit_cl(v, arg);
+        case DRM_IOCTL_V3D_SUBMIT_TFU:
+                return virtio_submit_tfu(v, arg);
+        case DRM_IOCTL_V3D_SUBMIT_CSD:
+                return virtio_submit_csd(v, arg);
+        case DRM_IOCTL_GEM_CLOSE: {
+                struct drm_gem_close *c = arg;
+                handle_close(v, c->handle);
+                return 0;
+        }
+        case DRM_IOCTL_GEM_OPEN: {
+                struct drm_gem_open *o = arg;
+                if (drmIoctl(screen->fd, request, arg))
+                        return -1;
+                handle_get(v, o->handle)->shared = true;
+                return 0;
+        }
+        case DRM_IOCTL_GEM_FLINK: {
+                struct drm_gem_flink *f = arg;
+                if (drmIoctl(screen->fd, request, arg))
+                        return -1;
+                handle_get(v, f->handle)->shared = true;
+                return 0;
+        }
+        case DRM_IOCTL_PRIME_FD_TO_HANDLE:
+                return virtio_prime_import(v, arg);
+        case DRM_IOCTL_PRIME_HANDLE_TO_FD:
+                return virtio_prime_export(v, arg);
+        default:
+                /* SUBMIT_CPU and PERFMON_*: not in the capset. */
+                return fail(EINVAL);
+        }
+}
+
+bool
+v3d_virtio_init(struct v3d_screen *screen)
+{
+        struct vdrm_device *vdrm =
+                vdrm_device_connect(screen->fd, VIRTGPU_DRM_CONTEXT_V3D);
+        if (!vdrm) {
+                mesa_loge("v3d: virtio-gpu offers no V3D native context");
+                return false;
+        }
+
+        struct v3d_virtio *v = calloc(1, sizeof(*v));
+        if (!v) {
+                vdrm_device_close(vdrm);
+                return false;
+        }
+
+        v->vdrm = vdrm;
+        util_sparse_array_init(&v->handles, sizeof(struct v3d_virtio_handle),
+                               512);
+        v->async_error = ((struct v3d_shmem *)vdrm->shmem)->async_error;
+
+        screen->virtio = v;
+        screen->ioctl = v3d_virtio_ioctl;
+        return true;
+}
+
+void
+v3d_virtio_fini(struct v3d_screen *screen)
+{
+        struct v3d_virtio *v = screen->virtio;
+        if (!v)
+                return;
+
+        util_sparse_array_finish(&v->handles);
+        vdrm_device_close(v->vdrm);
+        free(v);
+        screen->virtio = NULL;
+}
