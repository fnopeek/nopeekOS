+        /* The kernel interface: v3d's DRM ioctls, or their translation
+         * to a virtio-gpu native context (virtio set).
+         */
+        int (*ioctl)(struct v3d_screen *screen, unsigned long request,
+                     void *arg);
+        struct v3d_virtio *virtio;
+
         struct v3d_device_info devinfo;
 
         const char *name;
@@ -106,6 +115,12 @@ v3d_screen(struct pipe_screen *screen)
         return (struct v3d_screen *)screen;
 }
 
+static inline int
+v3d_screen_ioctl(struct v3d_screen *screen, unsigned long request, void *arg)
+{
+        return screen->ioctl(screen, request, arg);
+}
+
