+static int
+v3d_native_ioctl(struct v3d_screen *screen, unsigned long request, void *arg)
+{
+        if (request == DRM_IOCTL_PRIME_FD_TO_HANDLE ||
+            request == DRM_IOCTL_PRIME_HANDLE_TO_FD)
+                return drmIoctl(screen->fd, request, arg);
+
+        return v3d_ioctl(screen->fd, request, arg);
