# The guest Mesa: the release the pinned Arch snapshot ships (extra/mesa),
# its tarball's sha512 (the sha256 in Arch's PKGBUILD matches). Bump
# together with ARCH_SNAPSHOT; microvm/linux/mesa/build.sh and the
# userspace bundle refuse a mismatch.
MESA_VERSION=26.2.6
MESA_SHA512=0959679a8e9560a36d63bfc67357c73fde6fd98b00c29859ab30b31454b9ef8c8def38c7e180b168fd39080681042559dfc4a4252dfb289930a9776e0243c2dc
# The aarch64 guest's v3d build (build-v3d.sh): the release Arch Linux ARM
# ships for the pinned bundle (packages-firefox-aarch64.txt), as fetched
# from archive.mesa3d.org.
MESA_V3D_VERSION=26.2.7
MESA_V3D_SHA512=1886bd11f1a2cf8aad5289636004f26536c8dbef47848c15f1ca307b8f8e98dc853c5901630f9be37bd0f1bc044990b924ab698bd493751ce48acb8eddf569d1
