# Indirect calls in i915 resolved for Tiger Lake (8086:9A78, Gen12.1),
# Linux 6.18.55. Each line names the source that makes the choice; read
# by tools/linux-callgraph.py --follow-file.
#
# Platform facts used below (i915_pci.c tgl_info / GEN12..GEN7_FEATURES):
#   engines RCS0 BCS0 VCS0 VCS2 VECS0 (no CCS), ppgtt FULL 48 bit,
#   has_logical_ring_elsq, no LMEM, regions SMEM + STOLEN_SMEM.
#   enable_guc = 0 on TGL (gt/uc/intel_uc.c uc_expand_default_options).

# --- uncore: intel_uncore.c uncore_forcewake_init, GRAPHICS_VER >= 12
#     ASSIGN_READ/WRITE_MMIO_VFUNCS(fwtable), __gen12_fw_ranges,
#     intel_uncore_fw_domains_init: fw_get_funcs = uncore_get_fallback
@intel_uncore.h:373 = fwtable_read16
@intel_uncore.h:374 = fwtable_read32
@intel_uncore.h:375 = fwtable_read16
@intel_uncore.h:376 = fwtable_read32
@intel_uncore.h:379 = fwtable_write16
@intel_uncore.h:380 = fwtable_write32
@intel_uncore.h:397 = fwtable_read64
read_fw_domains  = fwtable_reg_read_fw_domains
write_fw_domains = fwtable_reg_write_fw_domains
force_wake_get   = fw_domains_get_with_fallback

# --- submission: intel_engine_cs.c intel_engines_init, HAS_EXECLISTS and
#     no GuC -> intel_execlists_submission_setup
@gt/intel_engine_cs.c:1514 = intel_execlists_submission_setup

# --- intel_execlists_submission.c logical_ring_default_vfuncs
resume                 = execlists_resume
request_alloc          = execlists_request_alloc
remove_active_request  = remove_from_engine
prepare                = execlists_reset_prepare
rewind                 = execlists_reset_rewind
cancel                 = execlists_reset_cancel
finish                 = execlists_reset_finish
set_default_submission = execlists_set_default_submission
sanitize               = execlists_sanitize
release                = execlists_release
callback               = execlists_submission_tasklet
# GRAPHICS_VER >= 12 for xcs; rcs_submission_override case 12 for RCS
emit_flush             = gen12_emit_flush_xcs
emit_flush             = gen12_emit_flush_rcs
emit_fini_breadcrumb   = gen12_emit_fini_breadcrumb_xcs
emit_fini_breadcrumb   = gen12_emit_fini_breadcrumb_rcs
# can_preempt: GRAPHICS_VER > 8; IP < 12.55
emit_bb_start          = gen8_emit_bb_start

# execlists_set_default_submission
submit_request         = execlists_submit_request
kick_backend           = kick_execlists
add_active_request     = add_to_engine
park                   = execlists_park
# GRAPHICS_VER >= 11: irq_enable/irq_disable stay NULL, unpark = NULL;
# bump_serial, bump_inflight_request_prio and revoke are GuC/ring only.

# --- intel_lrc.c: GRAPHICS_VER >= 12 sets ce->wa_bb_page (__lrc_alloc_state)
#     and __lrc_init_regs picks the indirect ctx bb by engine class;
#     lrc_init_wa_ctx returns early for GRAPHICS_VER >= 11
@gt/intel_lrc.c:1472 = gen12_emit_indirect_ctx_xcs
@gt/intel_lrc.c:1472 = gen12_emit_indirect_ctx_rcs

# --- execlists_context_ops
alloc      = execlists_context_alloc
pre_pin    = execlists_context_pre_pin
pin        = execlists_context_pin
unpin      = lrc_unpin
reset      = lrc_reset
post_unpin = lrc_post_unpin
enter      = intel_context_enter_engine
exit       = intel_context_exit_engine

# --- wakerefs: intel_engine_pm.c wf_ops, intel_gt_pm.c wf_ops
get = __engine_unpark
get = __gt_unpark
put = __engine_park
put = __gt_park

# --- GGTT: intel_ggtt.c ggtt_probe_hw -> gen8_gmch_probe; no BXT VT-d
#     serialisation, no MTL binder, no GuC invalidate
cleanup       = gen6_gmch_remove
clear_range   = nop_clear_range
scratch_range = gen8_ggtt_clear_range
invalidate    = gen8_ggtt_invalidate
bind_vma      = intel_ggtt_bind_vma
insert_entries = gen8_ggtt_insert_entries
pte_encode    = gen8_ggtt_pte_encode
alloc_scratch_dma = alloc_pt_dma

# --- PPGTT: intel_ppgtt.c -> gen8_ppgtt_create, no LMEM, GRAPHICS_VER >= 12
alloc_pt_dma      = alloc_pt_dma
pte_encode        = gen12_pte_encode
allocate_va_range = gen8_ppgtt_alloc
clear_range       = gen8_ppgtt_clear
foreach           = gen8_ppgtt_foreach
cleanup           = gen8_ppgtt_cleanup
bind_vma          = ppgtt_bind_vma
insert_entries    = gen8_ppgtt_insert
# intel_gtt.h set_pd_entry
@gt/intel_ppgtt.c:109 = gen8_pde_encode

# --- reset: intel_reset.c intel_get_gpu_reset, GRAPHICS_VER >= 8
@gt/intel_reset.c:787 = gen8_reset_engines

# --- memory: GEN_DEFAULT_REGIONS, !HAS_LMEM -> shmem + stolen smem;
#     internal objects for status pages and scratch
init        = init_shmem
init        = init_stolen_smem
init_object = shmem_object_init
init_object = _i915_gem_object_stolen_init
get_pages   = shmem_get_pages
get_pages   = i915_gem_object_get_pages_stolen
get_pages   = i915_gem_object_get_pages_internal
put_pages   = shmem_put_pages
put_pages   = i915_gem_object_put_pages_stolen
put_pages   = i915_gem_object_put_pages_internal
shrink      = shmem_shrink
release     = release_shmem
release     = release_stolen_smem

# --- scheduler
schedule = i915_schedule

# Not taken on TGL: sched_disable (GuC only), adjust_lru and
# unmap_virtual (TTM only), submit_request via resubmit_virtual_request
# (virtual engines, not created by the kernel itself),
# init_clock_gating (intel_clock_gating_hooks_init -> nop for TGL).

# --- interrupts: i915_irq.c intel_irq_handler, GRAPHICS_VER >= 11 and
#     IP < 12.10 -> gen11_irq_handler (a root, registered via request_irq);
#     logical_ring_default_vfuncs -> intel_engine_set_irq_handler
irq_handler = execlists_irq_handler

# ===== display (display/, pinned to TGL UY, DISPLAY_VER 12) =====
# Member names repeat across tables (get_hw_state: DPLL, encoder,
# connector, TC PHY, watermarks); each line names its table.

# intel_display.c intel_init_display_hooks: DISPLAY_VER >= 9 -> skl_display_funcs
get_pipe_config            = hsw_get_pipe_config
crtc_disable               = hsw_crtc_disable
get_initial_plane_config   = skl_get_initial_plane_config
fixup_initial_plane_config = skl_fixup_initial_plane_config

# intel_cdclk.c intel_init_cdclk_hooks: DISPLAY_VER >= 12 -> tgl_cdclk_funcs
get_cdclk          = bxt_get_cdclk
calc_voltage_level = tgl_calc_voltage_level

# intel_wm.c intel_wm_init -> skl_wm_init -> skl_wm_funcs (no update_wm)
get_hw_state = skl_wm_get_hw_state
sanitize     = skl_wm_sanitize

# intel_color.c intel_color_init_hooks: !HAS_GMCH, DISPLAY_VER >= 12 -> tgl_color_funcs
color_commit_arm   = icl_color_commit_arm
color_commit_noarm = icl_color_commit_noarm
get_config         = skl_get_config

# intel_fbc.c: DISPLAY_VER >= 7 -> ivb_fbc_funcs
deactivate = ilk_fbc_deactivate
is_active  = ilk_fbc_is_active

# intel_display.c intel_setup_outputs: VBT encoders -> intel_ddi_init
@display/intel_bios.c:3775 = intel_ddi_init

# intel_ddi.c intel_ddi_init: common hooks, then DISPLAY_VER >= 11 with
# combo ports (A, B) and Type-C ports (TC1..TC6)
get_hw_state      = intel_ddi_get_hw_state
sync_state        = intel_ddi_sync_state
get_power_domains = intel_ddi_get_power_domains
post_disable      = intel_ddi_post_disable
get_config        = icl_ddi_combo_get_config
get_config        = icl_ddi_tc_get_config
disable_clock     = icl_ddi_combo_disable_clock
disable_clock     = icl_ddi_tc_disable_clock
is_clock_enabled  = icl_ddi_combo_is_clock_enabled
is_clock_enabled  = icl_ddi_tc_is_clock_enabled
# intel_dp.c / intel_hdmi.c: HAS_DDI -> intel_ddi_connector_get_hw_state
get_hw_state      = intel_ddi_connector_get_hw_state

# intel_dpll_mgr.c intel_dpll_init: DISPLAY_VER >= 12 -> tgl_pll_mgr,
# tgl_plls = combo_pll_funcs x2, tbt_pll_funcs, dkl_pll_funcs x6
update_ref_clks = icl_update_dpll_ref_clks
dump_hw_state   = icl_dump_hw_state
get_hw_state    = combo_pll_get_hw_state
get_hw_state    = tbt_pll_get_hw_state
get_hw_state    = dkl_pll_get_hw_state
disable         = combo_pll_disable
disable         = tbt_pll_disable
disable         = mg_pll_disable

# intel_tc.c: DISPLAY_VER 12, not ADL-P -> tgl_tc_phy_ops
hpd_live_status = icl_tc_phy_hpd_live_status
get_hw_state    = icl_tc_phy_get_hw_state

# intel_display_power_map.c tgl_power_wells: always-on, pw_1, main, tc_cold_off, aux
sync_hw    = i9xx_power_well_sync_hw_noop
sync_hw    = hsw_power_well_sync_hw
sync_hw    = tgl_tc_cold_off_power_well_sync_hw
enable     = i9xx_always_on_power_well_noop
enable     = hsw_power_well_enable
enable     = gen9_dc_off_power_well_enable
enable     = icl_aux_power_well_enable
enable     = tgl_tc_cold_off_power_well_enable
disable    = i9xx_always_on_power_well_noop
disable    = hsw_power_well_disable
disable    = gen9_dc_off_power_well_disable
disable    = icl_aux_power_well_disable
disable    = tgl_tc_cold_off_power_well_disable
is_enabled = i9xx_always_on_power_well_enabled
is_enabled = hsw_power_well_enabled
is_enabled = gen9_dc_off_power_well_enabled
is_enabled = tgl_tc_cold_off_power_well_is_enabled

# skl_universal_plane.c skl_universal_plane_create: VER 12
max_stride    = skl_plane_max_stride
min_alignment = tgl_plane_min_alignment
disable_arm   = icl_plane_disable_arm

@intel_uncore.h:376 = fwtable_read32

# --- second display round (reached through intel_ddi_init)
# tgl_tc_phy_ops
cold_off_domain = tgl_tc_phy_cold_off_domain
connect         = icl_tc_phy_connect
disconnect      = icl_tc_phy_disconnect
is_owned        = icl_tc_phy_is_owned
is_ready        = icl_tc_phy_is_ready
# tgl_plls get_freq; intel_ddi_init DISPLAY_VER >= 11 TC port_pll_type
get_freq      = icl_ddi_combo_pll_get_freq
get_freq      = icl_ddi_tbt_pll_get_freq
get_freq      = icl_ddi_mg_pll_get_freq
port_pll_type = icl_ddi_tc_port_pll_type
post_pll_disable = intel_ddi_post_pll_disable
# tgl_color_funcs
read_csc  = icl_read_csc
read_luts = icl_read_luts
# intel_ddi_init: DISPLAY_VER >= 11, TC ports lock/unlock, connected per port kind
lock      = intel_tc_port_lock
unlock    = intel_tc_port_unlock
connected = intel_tc_port_connected
connected = lpt_digital_port_connected
# intel_hdmi.c intel_infoframe_init: HAS_DDI, LSPCON only if the VBT says so
write_infoframe    = hsw_write_infoframe
write_infoframe    = lspcon_write_infoframe
read_infoframe     = hsw_read_infoframe
read_infoframe     = lspcon_read_infoframe
set_infoframes     = hsw_set_infoframes
set_infoframes     = lspcon_set_infoframes
infoframes_enabled = hsw_infoframes_enabled
infoframes_enabled = lspcon_infoframes_enabled
# intel_hotplug_irq.c: DISPLAY_VER >= 11 -> gen11_hpd_funcs
hpd_enable_detection = gen11_hpd_enable_detection
# eDP only, run when the VBT lists a panel: PCH TGP >= CNP -> cnp_pwm_funcs;
# intel_pps.c pps index checks; intel_bios.c tries every panel-type source
setup = cnp_setup_backlight
@display/intel_pps.c:393 = pps_has_pp_on
@display/intel_pps.c:393 = pps_has_vdd_on
@display/intel_pps.c:393 = pps_any
get_panel_type = opregion_get_panel_type
get_panel_type = vbt_get_panel_type
get_panel_type = pnpid_get_panel_type
get_panel_type = fallback_get_panel_type
hz_to_pwm = cnp_hz_to_pwm
# Not followed: skl_wm_funcs has no update_wm; the quirk hooks never run
# on 8086:9A78 -- intel_quirks[] has no 0x9a78 and no DEVICE_ID_ANY entry,
# the DMI quirks name NCR, Thundersoft and Google Lillipup, the DPCD quirks
# two Dell machines (subsystem vendor 0x1028).

# --- stage-1 graph (GT + display readout together)
# gen8_gmch_probe: GGTT read-back, used by the initial plane takeover to
# find the firmware framebuffer's pages
read_entry = gen8_ggtt_read_entry
pte_decode = gen8_ggtt_pte_decode
# gen11_hpd_funcs (INTEL_HPD_FUNCS(gen11))
hpd_irq_setup = gen11_hpd_irq_setup
