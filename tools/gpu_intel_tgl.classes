# Classes for the TGL call graph, by defining file (first match wins);
# read by tools/linux-callgraph.py --classes. Unmatched files are B.
#   A  programs the hardware: port 1:1
#   N  not on TGL (reason after #)
#   B  Linux bookkeeping: own counterpart on gpudev, same effect on hardware

N ^gt/gen6_ppgtt\.          # aliasing PPGTT, TGL has full 48-bit PPGTT
N ^gt/intel_ggtt_gmch\.     # Gen5 and older GMCH
N ^gt/intel_gt_ccs_mode\.   # TGL has no CCS
N ^gt/intel_sa_media\.      # MTL standalone media
N ^gt/intel_region_lmem\.   # no LMEM
N ^gt/intel_migrate\.       # LMEM copies
N ^vlv_                     # Valleyview
N ^i915_cmd_parser\.        # no command parser on Gen12
N ^i915_vgpu\.              # GVT guest detection, we run bare
N ^gem/i915_gem_(lmem|ttm|phys)\.   # LMEM / TTM / phys objects
N ^(intel_region_ttm|i915_ttm_buddy_manager)\.

A ^(\./\./)?intel_uncore
A ^intel_(pcode|step|device_info|clock_gating)\.
A ^i915_irq\.
A ^(\./\./)?gt/(gen8_engine_cs|gen8_ppgtt|intel_ppgtt|intel_gtt|intel_ggtt|intel_ggtt_fencing|intel_breadcrumbs|intel_engine_cs|intel_engine\.h|intel_engine_heartbeat|intel_execlists_submission|intel_gt\.|intel_gt_clock_utils|intel_gt_irq|intel_gt_mcr|intel_gt_pm_irq|intel_gt_pm\.|intel_engine_pm\.|intel_llc|intel_lrc|intel_mocs|intel_rc6|intel_renderstate|intel_reset|intel_ring|intel_rps|intel_sseu|intel_timeline|intel_tlb|intel_wopcm|intel_workarounds)

# Function-level overrides (@name), checked before the file rules. These
# live in bookkeeping files but fix the order of the bring-up, read the
# hardware or write the ring, so they are ported 1:1 as well.
# bring-up order (i915_driver.c, i915_gem.c)
A @i915_driver_probe
A @i915_driver_early_probe
A @i915_driver_mmio_probe
A @i915_driver_hw_probe
A @i915_set_dma_info               # DMA mask 39 bits: bounds our allocations
A @intel_detect_preproduction_hw
A @sanitize_gpu
A @i915_pcode_init
A @i915_gem_init
# stolen memory layout: reserved ranges read from the hardware
A @i915_gem_stolen_smem_setup
A @init_stolen_smem
A @i915_gem_init_stolen
A @adjust_stolen
A @request_smem_stolen
A @valid_stolen_size
A @init_reserved_stolen
A @icl_get_stolen_reserved
# requests: what goes into the ring and in which order
A @__i915_request_create
A @__i915_request_commit
A @__i915_request_add_to_timeline
A @__i915_request_submit
A @__i915_request_unsubmit
A @__i915_request_fill
A @emit_semaphore_wait
A @__emit_semaphore_wait
A @can_use_semaphore_wait

# Display: nearly every function reads or writes display registers
# (intel_de_*) or decodes firmware tables (VBT, intel_bios.c) -- port 1:1.
# Bookkeeping files first, since the first match wins.
B ^display/(intel_display_rpm|intel_frontbuffer|intel_fb_bo|intel_bo|intel_display_conversion|intel_display_types\.h|intel_display_trace)
A ^(\./\./)?display/
# soc/: DRAM info and the VBT from the option ROM, read from the hardware.
A ^(\./\./)?soc/
