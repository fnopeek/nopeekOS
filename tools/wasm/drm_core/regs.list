# Mode tables (drm_edid.c): clock, h, v, flags, type, aspect, name
@ drm_edid.c
TABLE drm_dmt_modes: x.clock, x.hdisplay, x.hsync_start, x.hsync_end, x.htotal, x.hskew, x.vdisplay, x.vsync_start, x.vsync_end, x.vtotal, x.vscan, x.flags, x.type, x.picture_aspect_ratio, x.name$32
TABLE edid_est_modes: x.clock, x.hdisplay, x.hsync_start, x.hsync_end, x.htotal, x.hskew, x.vdisplay, x.vsync_start, x.vsync_end, x.vtotal, x.vscan, x.flags, x.type, x.picture_aspect_ratio, x.name$32
TABLE edid_cea_modes_1: x.clock, x.hdisplay, x.hsync_start, x.hsync_end, x.htotal, x.hskew, x.vdisplay, x.vsync_start, x.vsync_end, x.vtotal, x.vscan, x.flags, x.type, x.picture_aspect_ratio, x.name$32
TABLE edid_cea_modes_193: x.clock, x.hdisplay, x.hsync_start, x.hsync_end, x.htotal, x.hskew, x.vdisplay, x.vsync_start, x.vsync_end, x.vtotal, x.vscan, x.flags, x.type, x.picture_aspect_ratio, x.name$32
TABLE edid_4k_modes: x.clock, x.hdisplay, x.hsync_start, x.hsync_end, x.htotal, x.hskew, x.vdisplay, x.vsync_start, x.vsync_end, x.vtotal, x.vscan, x.flags, x.type, x.picture_aspect_ratio, x.name$32
TABLE est3_modes: x.w, x.h, x.r, x.rb
TABLE extra_modes: x.w, x.h, x.r, x.rb
