# Pixel formats (drm_fourcc.c's table, uapi/drm/drm_fourcc.h)
@ drm_fourcc.c
COPY drm_formats = static const struct drm_format_info formats[]
TABLE drm_formats: x.format, x.num_planes, x.cpp[0], x.cpp[1], x.cpp[2], x.hsub, x.vsub, x.has_alpha, x.is_yuv
DRM_FORMAT_MOD_LINEAR
DRM_FORMAT_MOD_VENDOR_BROADCOM
DRM_FORMAT_MOD_BROADCOM_SAND128_CODE = DRM_FORMAT_MOD_BROADCOM_SAND128 & 0xffffffff
DRM_FORMAT_MOD_BROADCOM_SAND256_CODE = DRM_FORMAT_MOD_BROADCOM_SAND256 & 0xffffffff
DRM_FORMAT_MOD_BROADCOM_PARAM_SHIFT = __fourcc_mod_broadcom_param_shift
DRM_FORMAT_MOD_BROADCOM_PARAM_BITS = __fourcc_mod_broadcom_param_bits
DRM_FORMAT_YUV444
DRM_FORMAT_YVU444
DRM_FORMAT_P030
DRM_FORMAT_XRGB8888
DRM_FORMAT_RGB565
