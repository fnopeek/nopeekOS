                 nir_def *is_cur_sample = nir_ieq_imm(b, sample_id, i);
-                nir_def *val = v3d_nir_get_tlb_color(b, c, rt, i);
+                nir_def *val = get_tlb_color(b, rt, i, n);
                 out = nir_bcsel(b, is_cur_sample, val, out);
         }
 
