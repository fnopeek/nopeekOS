#version 460
// One segment of a scene list (compose.rs) over one area: a workgroup is a
// row of WIDTH pixels by ROWS rows inside one 64x64 bin, and runs only the
// items compose.rs listed for that bin, in order, on a colour held in a
// register, row by row. A list that starts with an item covering the bin
// opaquely skips the read of the target. Item and frame words are uniform
// per workgroup: lane k loads word k % 16 of a 16-word block in one
// message, the words are then broadcast, always while every lane is
// active: a broadcast from a lane that has left reads nothing defined.
// A bit-exact port of the kernel's CPU executor (kernel/src/shade/scene.rs
// `paint` and the helpers it calls in gui/render.rs, gui/background.rs and
// gui/theme.rs); comments name the function each part mirrors.

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_GOOGLE_include_directive : require

// The workgroup is one subgroup of the card: 16 lanes on Intel (SIMD16),
// 64 on AMD (wave64); the module sets it at compile time.
layout(constant_id = 0) const uint WIDTH = 16u;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
    uint v[];
};

layout(push_constant, std430) uniform Params {
    // Frame block and items (compose.rs F_*, ITEMS).
    Words frame;
    // The blurred planes of the panel this segment starts with.
    Words planes;
    // Per bin {list offset, count | opaque << 31}, then the lists.
    Words bins;
    uint clip_x;
    uint clip_y;
    uint clip_w;
    uint clip_h;
    // First column of the area, in workgroup widths.
    uint gx0;
    // First run of ROWS rows of the area, in ROWS.
    uint gy0;
    // First bin of the area, in 64s, and bins per row.
    uint bin_x0;
    uint bin_y0;
    uint nbx;
    uint bx0;
    uint by0;
    // 0: no blur, the panel sits on the pixel beneath.
    uint bsw;
    uint bsh;
} p;

// Word offsets in the frame block (compose.rs).
const uint F_TARGET = 0u;
const uint F_TARGET_PITCH = 2u;
const uint F_FLAGS = 3u;
const uint F_WALL = 4u;
const uint F_WALL_PITCH = 6u;
const uint F_BLUR = 7u;
const uint F_BLUR_PITCH = 9u;
const uint F_GLASS = 10u;
const uint F_GLASS_PITCH = 12u;
const uint F_INK_CEIL = 13u;
const uint F_INK_TINT = 14u;
const uint F_INK_TINT_W = 15u;
const uint F_GLYPHS = 18u;
const uint ITEMS = 32u;
const uint ITEM_WORDS = 16u;

const uint FLAG_WALL = 1u;
const uint FLAG_BLURRED = 2u;
const uint FLAG_GLASS = 4u;

// Rows per thread; divides the bin height, so a thread stays in its bin.
const uint ROWS = 16u;

// BLOCKS-BEGIN
// A 16-word block: lane k holds word k % 16. `BC` reads word k (constant),
// `SH` word n (dynamically uniform).
#define Blk uint
Blk blk_load(Words w, uint base) {
    return w.v[base + (gl_SubgroupInvocationID & 15u)];
}
#define BC(b, k) subgroupBroadcast(b, k)
#define SH(b, n) subgroupShuffle(b, n)
// BLOCKS-END

#define PANEL_PLANES p.planes
#define PANEL_BSW p.bsw
#define PANEL_BSH p.bsh
#define PANEL_BX0 p.bx0
#define PANEL_BY0 p.by0
#include "items.glsl"

void main() {
    uint x0 = (p.gx0 + gl_WorkGroupID.x) * WIDTH;
    uint x = x0 + gl_LocalInvocationID.x;
    uint ry0 = (p.gy0 + gl_WorkGroupID.y) * ROWS;
    uint bin = ((ry0 >> 6) - p.bin_y0) * p.nbx + ((x0 >> 6) - p.bin_x0);
    Blk hdr = blk_load(p.bins, bin * 2u);
    uint off = BC(hdr, 0);
    uint head = BC(hdr, 1);
    uint count = head & 0x7FFFFFFFu;
    if (count == 0u)
        return;
    Blk f0 = blk_load(p.frame, 0u);
    Blk f1 = blk_load(p.frame, 16u);
    g_flags = BC(f0, F_FLAGS);
    g_ceil = BC(f0, F_INK_CEIL);
    g_tint = BC(f0, F_INK_TINT);
    g_tint_w = BC(f0, F_INK_TINT_W);
    g_wall = mkaddr(BC(f0, F_WALL), BC(f0, F_WALL + 1u));
    g_wall_pitch = BC(f0, F_WALL_PITCH);
    g_blur = mkaddr(BC(f0, F_BLUR), BC(f0, F_BLUR + 1u));
    g_blur_pitch = BC(f0, F_BLUR_PITCH);
    g_glass = mkaddr(BC(f0, F_GLASS), BC(f0, F_GLASS + 1u));
    g_glass_pitch = BC(f0, F_GLASS_PITCH);
    g_glyphs = mkaddr(BC(f1, F_GLYPHS - 16u), BC(f1, F_GLYPHS - 15u));
    Words target = mkaddr(BC(f0, F_TARGET), BC(f0, F_TARGET + 1u));
    uint tpitch = BC(f0, F_TARGET_PITCH);
    bool inside_x = x >= p.clip_x && x < p.clip_x + p.clip_w;
    bool opaque = (head >> 31) != 0u;


    uint y_lo = max(ry0, p.clip_y);
    uint y_hi = min(ry0 + ROWS, p.clip_y + p.clip_h);

    // A bin that one item covers opaquely is a copy: the wallpaper, or a
    // window's pixels (scene::content's straight rows), loaded once.
    if (opaque && count == 1u) {
        Blk list = blk_load(p.bins, off);
        Blk it = blk_load(p.frame, ITEMS + SH(list, 0u) * ITEM_WORDS);
        uint kind = BC(it, 0);
        // Every lane leaves here together.
        if (kind == 1u) {
            if (!inside_x)
                return;
            if ((g_flags & FLAG_WALL) == 0u) {
                for (uint y = y_lo; y < y_hi; y++)
                    target.v[y * tpitch + x] = 0xFF181820u;
                return;
            }
            // Four rows per step: their loads are in flight together.
            for (uint y = y_lo; y < y_hi; y += 4u) {
                uint v0 = g_wall.v[y * g_wall_pitch + x];
                uint v1 = y + 1u < y_hi ? g_wall.v[(y + 1u) * g_wall_pitch + x] : 0u;
                uint v2 = y + 2u < y_hi ? g_wall.v[(y + 2u) * g_wall_pitch + x] : 0u;
                uint v3 = y + 3u < y_hi ? g_wall.v[(y + 3u) * g_wall_pitch + x] : 0u;
                target.v[y * tpitch + x] = v0;
                if (y + 1u < y_hi)
                    target.v[(y + 1u) * tpitch + x] = v1;
                if (y + 2u < y_hi)
                    target.v[(y + 2u) * tpitch + x] = v2;
                if (y + 3u < y_hi)
                    target.v[(y + 3u) * tpitch + x] = v3;
            }
            return;
        }
        // YUYV content takes the per-pixel path below.
        if (kind == 5u && (BC(it, 6) >> 1) == 0u) {
            uint dx = BC(it, 1), dy = BC(it, 2), dw = BC(it, 3), dh = BC(it, 4);
            uint fit = BC(it, 6);
            Words src = mkaddr(BC(it, 7), BC(it, 8));
            uint sw = BC(it, 9), sh = BC(it, 10), spitch = BC(it, 11);
            if (!inside_x)
                return;
            bool scale = fit == 0u && (sw != dw || sh != dh);
            uint sx = x - dx;
            if (scale)
                sx = sx * sw / max(dw, 1u);
            sx = min(sx, sw - 1u);
            uint v[4];
            for (uint y = y_lo; y < y_hi; y += 4u) {
                for (uint k = 0u; k < 4u; k++) {
                    uint sy = y + k - dy;
                    if (scale)
                        sy = sy * sh / max(dh, 1u);
                    v[k] = y + k < y_hi ? src.v[min(sy, sh - 1u) * spitch + sx] : 0u;
                }
                for (uint k = 0u; k < 4u; k++)
                    if (y + k < y_hi)
                        target.v[(y + k) * tpitch + x] = v[k];
            }
            return;
        }
    }
    // A bin inside a window's glass (fill_rounded_chrome_aa's straight
    // rows, opaque or tinted from the glass source), with at most text and
    // fills over it: the glass per pixel, then those, items loaded once.
    if (opaque && count <= 4u) {
        Blk list = blk_load(p.bins, off);
        Blk g0 = blk_load(p.frame, ITEMS + SH(list, 0u) * ITEM_WORDS);
        Blk g1 = g0;
        Blk g2 = g0;
        Blk g3 = g0;
        if (count > 1u)
            g1 = blk_load(p.frame, ITEMS + SH(list, 1u) * ITEM_WORDS);
        if (count > 2u)
            g2 = blk_load(p.frame, ITEMS + SH(list, 2u) * ITEM_WORDS);
        if (count > 3u)
            g3 = blk_load(p.frame, ITEMS + SH(list, 3u) * ITEM_WORDS);
        uint k1 = count > 1u ? BC(g1, 0) : 0u;
        uint k2 = count > 2u ? BC(g2, 0) : 0u;
        uint k3 = count > 3u ? BC(g3, 0) : 0u;
        bool over = (k1 == 0u || k1 == 7u || k1 == 8u) && (k2 == 0u || k2 == 7u || k2 == 8u)
            && (k3 == 0u || k3 == 7u || k3 == 8u);
        if (BC(g0, 0) == 4u && over) {
            uint bg = BC(g0, 7);
            uint go = min(BC(g0, 11), 255u);
            uint glass_fill = ink_fill(bg, g_tint, g_tint_w);
            for (uint y = y_lo; y < y_hi; y++) {
                uint c = bg;
                if (go < 255u) {
                    uint wpx = inside_x ? g_glass.v[y * g_glass_pitch + x] : 0u;
                    c = glass_blend(glass_fill, wpx, go, g_ceil);
                }
                if (k1 != 0u)
                    c = k1 == 7u ? text(g1, x, y, c) : fill(g1, x, y, c);
                if (k2 != 0u)
                    c = k2 == 7u ? text(g2, x, y, c) : fill(g2, x, y, c);
                if (k3 != 0u)
                    c = k3 == 7u ? text(g3, x, y, c) : fill(g3, x, y, c);
                if (inside_x)
                    target.v[y * tpitch + x] = c;
            }
            return;
        }
    }
    for (uint y = y_lo; y < y_hi; y++) {
        uint at = y * tpitch + x;
        uint c = 0u;
        if (!opaque && inside_x)
            c = target.v[at];
        for (uint n = 0u; n < count; n += 16u) {
            Blk list = blk_load(p.bins, off + n);
            uint m = min(16u, count - n);
            for (uint j = 0u; j < m; j++) {
                Blk it = blk_load(p.frame, ITEMS + SH(list, j) * ITEM_WORDS);
                switch (BC(it, 0)) {
                case 1u:
                    c = (g_flags & FLAG_WALL) != 0u ? g_wall.v[y * g_wall_pitch + x] : 0xFF181820u;
                    break;
                case 2u: c = glow(it, x, y, c); break;
                case 3u: c = glass_backdrop(it, x, y, c); break;
                case 4u: c = chrome(it, x, y, c); break;
                case 5u: c = content(it, x, y, c); break;
                case 6u: c = panel(it, x, y, c); break;
                case 7u: c = text(it, x, y, c); break;
                case 8u: c = fill(it, x, y, c); break;
                case 9u: c = close_glyph(it, x, y, c); break;
                default: break;
                }
            }
        }
        if (inside_x)
            target.v[at] = c;
    }
}
