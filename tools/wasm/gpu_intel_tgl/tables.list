@ intel_uncore.c
__gen12_fw_ranges: intel_forcewake_range { start, end, domains }
gen12_shadowed_regs: i915_range { start, end }
@ intel_step.c
tgl_uy_revids: intel_step_info { graphics_step, media_step }
@ intel_device_info.c
subplatform_ult_ids: u16
subplatform_ulx_ids: u16
subplatform_portf_ids: u16
subplatform_uy_ids: u16
subplatform_n_ids: u16
subplatform_rpl_ids: u16
subplatform_rplu_ids: u16
subplatform_g10_ids: u16
subplatform_g11_ids: u16
subplatform_g12_ids: u16
subplatform_dg2_d_ids: u16
subplatform_arl_h_ids: u16
subplatform_arl_u_ids: u16
subplatform_arl_s_ids: u16
@ display/intel_display_device.c
tgl_uy_steppings: u32
@ gt/intel_engine_cs.c
intel_engines: engine_info { class, instance, ver0=mmio_bases[0].graphics_ver, base0=mmio_bases[0].base, ver1=mmio_bases[1].graphics_ver, base1=mmio_bases[1].base, ver2=mmio_bases[2].graphics_ver, base2=mmio_bases[2].base }
@ display/intel_bios.c
vbt_signature: u8
@ display/intel_display_power_map.c
tgl_power_wells[] / @.list[@.count] / @.instances->list[@.instances->count] => tgl_power_well_insts: power_well_inst { desc=n1, instance_idx=i2, name=e2.name as str, id=e2.id, hsw_idx=e2.hsw.idx, ops=e1.ops as sym, irq_pipe_mask=e1.irq_pipe_mask, always_on=e1.always_on, fixed_enable_delay=e1.fixed_enable_delay, has_vga=e1.has_vga, has_fuses=e1.has_fuses, is_tc_tbt=e1.is_tc_tbt, enable_timeout=e1.enable_timeout, domain_list=!e2.domain_list ? 0 : e2.domain_list->count == 0 ? 1 : 2 }
tgl_power_wells[] / @.list[@.count] / @.instances->list[@.instances->count] / @.domain_list->list[@.domain_list ? @.domain_list->count : 0] => tgl_power_well_domains: power_well_domain { well=n2, domain=e3 }
@ display/intel_combo_phy.c
icl_procmon_values[] => icl_procmon_values: icl_procmon { name=e0.name as str, dw1=e0.dw1, dw9=e0.dw9, dw10=e0.dw10 }
@ display/intel_cdclk.c
icl_cdclk_table: intel_cdclk_vals { cdclk, refclk, waveform, ratio }
tgl_calc_voltage_level::tgl_voltage_level_max_cdclk: i32
@ display/intel_bios.c
bdb_blocks: bdb_block { section_id, min_size }
icp_ddc_pin_map: u8
direct_aux_ch_map: u8
@ display/intel_gmbus.c
gmbus_pins_icp: gmbus_pin { valid=name != 0 }
@ display/intel_display_power.c
tgl_buddy_page_masks: buddy_page_mask { page_mask, ty=type, num_channels }
@ display/intel_gmbus.c
gmbus_pins_icp[] => gmbus_pins_icp_gpio: gmbus_pin_gpio { valid=e0.name != 0, gpio=e0.gpio }
