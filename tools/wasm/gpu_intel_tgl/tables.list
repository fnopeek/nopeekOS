@ display/intel_hdmi.c
infoframe_type_to_idx: u8
@ display/skl_watermark.c
tgl_allowed_dbufs: dbuf_slice_conf_entry { active_pipes, join_mbus, m0=dbuf_mask[0], m1=dbuf_mask[1], m2=dbuf_mask[2], m3=dbuf_mask[3] }
@ gt/intel_gt_mcr.c
