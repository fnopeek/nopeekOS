#version 460
// One segment of a scene list (compose.rs) over one clip rectangle: every
// pixel runs the segment's items in order on a colour held in a register.
// A bit-exact port of the kernel's CPU executor (kernel/src/shade/scene.rs
// `paint` and the helpers it calls in gui/render.rs, gui/background.rs and
// gui/theme.rs); comments name the function each part mirrors.

#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 16, local_size_y = 1, local_size_z = 1) in;

layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words {
    uint v[];
};

layout(push_constant, std430) uniform Params {
    // Frame parameters (compose.rs PARAM_*), the items follow at ITEMS.
    Words frame;
    // The blurred planes of the panel this segment starts with.
    Words planes;
    uint clip_x;
    uint clip_y;
    uint clip_w;
    uint clip_h;
    uint first;
    uint count;
    uint bx0;
    uint by0;
    // 0: no blur, the panel sits on the pixel beneath.
    uint bsw;
    uint bsh;
} p;

// Word offsets in the frame block (compose.rs).
const uint F_TARGET = 0u;
const uint F_TARGET_PITCH = 2u;
const uint F_FLAGS = 3u;
const uint F_WALL = 4u;
const uint F_WALL_PITCH = 6u;
const uint F_BLUR = 7u;
const uint F_BLUR_PITCH = 9u;
const uint F_GLASS = 10u;
const uint F_GLASS_PITCH = 12u;
const uint F_INK_CEIL = 13u;
const uint F_INK_TINT = 14u;
const uint F_INK_TINT_W = 15u;
const uint F_WIDTH = 16u;
const uint F_HEIGHT = 17u;
const uint F_GLYPHS = 18u;
const uint ITEMS = 32u;
const uint ITEM_WORDS = 16u;

const uint FLAG_WALL = 1u;
const uint FLAG_BLURRED = 2u;
const uint FLAG_GLASS = 4u;

Words addr(uint w) {
    return Words(uint64_t(p.frame.v[w]) | (uint64_t(p.frame.v[w + 1u]) << 32));
}

// render::blend, alpha 0..=256.
uint blend(uint fg, uint bg, uint a) {
    uint inv = 256u - a;
    uint r = (((fg >> 16) & 255u) * a + ((bg >> 16) & 255u) * inv) >> 8;
    uint g = (((fg >> 8) & 255u) * a + ((bg >> 8) & 255u) * inv) >> 8;
    uint b = ((fg & 255u) * a + (bg & 255u) * inv) >> 8;
    return (r << 16) | (g << 8) | b;
}

// render::luma.
uint luma(uint c) {
    return (((c >> 16) & 255u) * 299u + ((c >> 8) & 255u) * 587u + (c & 255u) * 114u) / 1000u;
}

// render::glass_blend.
uint glass_blend(uint fg, uint bg, uint alpha, uint ceil_) {
    uint a = min(alpha, 256u);
    uint lf = luma(fg);
    uint lb = luma(bg);
    if (ceil_ < 255u && lb > ceil_ && lf < ceil_) {
        uint d = lb - lf;
        uint need = ((lb - ceil_) * 256u + d - 1u) / d;
        a = max(a, min(need, 256u));
    }
    return blend(fg, bg, a);
}

// GlassInk::fill.
uint ink_fill(uint fg, uint tint, uint tint_w) {
    return tint_w == 0u ? fg : blend(tint, fg, tint_w);
}

// theme::lerp_color.
uint lerp_color(uint a, uint b, uint t) {
    t = min(t, 1000u);
    uint inv = 1000u - t;
    uint r = (((a >> 16) & 255u) * inv + ((b >> 16) & 255u) * t) / 1000u;
    uint g = (((a >> 8) & 255u) * inv + ((b >> 8) & 255u) * t) / 1000u;
    uint bl = ((a & 255u) * inv + (b & 255u) * t) / 1000u;
    return (r << 16) | (g << 8) | bl;
}

// Floor of the square root (render::isqrt_u64, background::isqrt).
uint isqrt(uint64_t n) {
    uint x = uint(sqrt(float(n)));
    for (int i = 0; i < 8 && uint64_t(x) * uint64_t(x) > n; i++)
        x--;
    for (int i = 0; i < 8 && uint64_t(x + 1u) * uint64_t(x + 1u) <= n; i++)
        x++;
    return x;
}

// render::arc_coverage_sdf.
uint arc_coverage(int cdx, int cdy, int r_q8) {
    int64_t dx = int64_t(cdx);
    int64_t dy = int64_t(cdy);
    int d = int(isqrt(uint64_t(dx * dx + dy * dy)));
    int s = d - r_q8;
    if (s <= -150)
        return 256u;
    if (s >= 150)
        return 0u;
    uint t = uint((s + 150) * 256 / 300);
    uint smoothed = t * t * (768u - 2u * t) / 65536u;
    return smoothed >= 256u ? 0u : 256u - smoothed;
}

// render::rect_coverage_sdf.
uint rect_coverage(uint px, uint py, uint rx, uint ry, uint rw, uint rh, uint r) {
    if (px < rx || py < ry || px >= rx + rw || py >= ry + rh)
        return 0u;
    if (r == 0u)
        return 256u;
    int in_x = int(px - rx);
    int in_y = int(py - ry);
    int ri = int(r);
    int cdx;
    int cdy;
    if (in_x < ri)
        cdx = ri - 1 - in_x;
    else if (in_x >= int(rw) - ri)
        cdx = in_x - (int(rw) - ri);
    else
        return 256u;
    if (in_y < ri)
        cdy = ri - 1 - in_y;
    else if (in_y >= int(rh) - ri)
        cdy = in_y - (int(rh) - ri);
    else
        return 256u;
    return arc_coverage(cdx * 256 + 128, cdy * 256 + 128, ri * 256);
}

// render::rrect_distance_sdf.
int rrect_distance(uint px, uint py, uint rx, uint ry, uint rw, uint rh, uint r) {
    int pcx = int(px) * 256 + 128;
    int pcy = int(py) * 256 + 128;
    int lo_x = int(rx + r) * 256;
    int hi_x = int(rx + rw - r) * 256;
    int lo_y = int(ry + r) * 256;
    int hi_y = int(ry + rh - r) * 256;
    int64_t qx = int64_t(max(max(lo_x - pcx, pcx - hi_x), 0));
    int64_t qy = int64_t(max(max(lo_y - pcy, pcy - hi_y), 0));
    return int(isqrt(uint64_t(qx * qx + qy * qy))) - int(r) * 256;
}

uint word(uint i, uint k) {
    return p.frame.v[ITEMS + i * ITEM_WORDS + k];
}

// render::draw_glow_ring at one pixel.
uint glow(uint i, uint x, uint y, uint c) {
    uint rx = word(i, 1u), ry = word(i, 2u), rw = word(i, 3u), rh = word(i, 4u);
    uint r = word(i, 5u), color = word(i, 6u), width = word(i, 7u), alpha = word(i, 8u);
    if (width == 0u || alpha == 0u || rw < 2u || rh < 2u)
        return c;
    r = min(r, min(rw / 2u, rh / 2u));
    uint x0 = rx >= width ? rx - width : 0u;
    uint y0 = ry >= width ? ry - width : 0u;
    if (x < x0 || y < y0 || x >= rx + rw + width || y >= ry + rh + width)
        return c;
    if (rect_coverage(x, y, rx, ry, rw, rh, r) > 0u)
        return c;
    int band_q8 = int(width) * 256;
    int d = max(rrect_distance(x, y, rx, ry, rw, rh, r), 0);
    if (d >= band_q8)
        return c;
    uint f = min(uint((band_q8 + 128 - d) * 256 / band_q8), 256u);
    uint a = alpha * f / 256u;
    return a > 0u ? blend(color, c, min(a, 256u)) : c;
}

// background::draw_glass_backdrop at one pixel.
uint glass_backdrop(uint i, uint x, uint y, uint c) {
    if ((p.frame.v[F_FLAGS] & FLAG_BLURRED) == 0u)
        return c;
    uint rx = word(i, 1u), ry = word(i, 2u), rw = word(i, 3u), rh = word(i, 4u);
    uint r = min(word(i, 5u), min(rw / 2u, rh / 2u));
    if (y < ry || y >= ry + rh)
        return c;
    uint ly = y - ry;
    uint from_edge = ly < r ? r - ly : (ly >= rh - r ? ly + 1u - (rh - r) : 0u);
    uint inset = from_edge == 0u ? 0u : r - isqrt(uint64_t(r * r - min(from_edge * from_edge, r * r)));
    uint x0 = rx + inset;
    uint x1 = rx + rw >= inset ? rx + rw - inset : 0u;
    if (x < x0 || x >= x1)
        return c;
    return addr(F_BLUR).v[y * p.frame.v[F_BLUR_PITCH] + x];
}

// render::fill_rounded_chrome_aa at one pixel.
uint chrome(uint i, uint px, uint py, uint c) {
    uint x = word(i, 1u), y = word(i, 2u), w = word(i, 3u), h = word(i, 4u);
    if (w < 2u || h < 2u || px < x || py < y || px >= x + w || py >= y + h)
        return c;
    uint border_a = word(i, 5u), border_b = word(i, 6u), bg = word(i, 7u);
    uint rounding = word(i, 8u), border = word(i, 9u);
    uint bo = min(word(i, 10u), 255u);
    uint go = min(word(i, 11u), 255u);
    bool paint_content = word(i, 12u) != 0u;
    uint r_out = min(rounding, min(w / 2u, h / 2u));
    uint border_px = min(min(border, r_out), min(w / 2u, h / 2u));
    uint inner_x = x + border_px;
    uint inner_y = y + border_px;
    uint inner_w = w - 2u * border_px;
    uint inner_h = h - 2u * border_px;
    uint r_in = min(r_out >= border_px ? r_out - border_px : 0u, min(inner_w / 2u, inner_h / 2u));
    bool solid = border_a == border_b;
    uint ceil_ = paint_content ? p.frame.v[F_INK_CEIL] : 255u;
    uint tint_w = paint_content ? p.frame.v[F_INK_TINT_W] : 0u;
    uint glass_fill = ink_fill(bg, p.frame.v[F_INK_TINT], tint_w);
    uint diag_max = max(w + h, 1u);

    uint straight_lo = inner_y + r_in;
    uint straight_hi = inner_y + inner_h >= r_in ? inner_y + inner_h - r_in : 0u;
    uint skip_lo = inner_x + 2u;
    uint skip_hi = inner_x + inner_w >= 2u ? inner_x + inner_w - 2u : 0u;
    if (py >= straight_lo && py < straight_hi && px >= skip_lo && px < skip_hi) {
        if (!paint_content)
            return c;
        if (go >= 255u)
            return bg;
        if ((p.frame.v[F_FLAGS] & FLAG_GLASS) != 0u) {
            uint wpx = addr(F_GLASS).v[py * p.frame.v[F_GLASS_PITCH] + px];
            return glass_blend(glass_fill, wpx, go, ceil_);
        }
        uint bc = solid ? border_a : lerp_color(border_a, border_b, ((px - x) + (py - y)) * 1000u / diag_max);
        return glass_blend(glass_fill, blend(bc, c, bo), go, ceil_);
    }

    uint outer = rect_coverage(px, py, x, y, w, h, r_out);
    if (outer == 0u)
        return c;
    uint border_color = solid ? border_a
        : lerp_color(border_a, border_b, min(((px - x) + (py - y)) * 1000u / diag_max, 1000u));
    if (outer < 256u)
        return blend(border_color, c, min(outer * bo / 256u, 255u));
    uint inner = border_px == 0u ? 256u : rect_coverage(px, py, inner_x, inner_y, inner_w, inner_h, r_in);
    if (!paint_content)
        return inner == 256u ? c : blend(border_color, c, bo);
    if (inner == 0u)
        return blend(border_color, c, bo);
    if (inner == 256u)
        return glass_blend(glass_fill, c, go, ceil_);
    return glass_blend(glass_fill, blend(border_color, c, bo), min(go * inner / 256u, 255u), ceil_);
}

// scene::content at one pixel.
uint content(uint i, uint x, uint y, uint c) {
    uint dx = word(i, 1u), dy = word(i, 2u), dw = word(i, 3u), dh = word(i, 4u);
    if (x < dx || y < dy || x >= dx + dw || y >= dy + dh)
        return c;
    uint radius = word(i, 5u), fit = word(i, 6u);
    Words src = Words(uint64_t(word(i, 7u)) | (uint64_t(word(i, 8u)) << 32));
    uint sw = word(i, 9u), sh = word(i, 10u), spitch = word(i, 11u);
    uint r = min(radius, min(dw / 2u, dh / 2u));
    uint cov = rect_coverage(x, y, dx, dy, dw, dh, r);
    if (cov == 0u)
        return c;
    uint lx = x - dx;
    uint ly = y - dy;
    uint sx = lx;
    uint sy = ly;
    if (fit == 0u && (sw != dw || sh != dh)) {
        sx = lx * sw / max(dw, 1u);
        sy = ly * sh / max(dh, 1u);
    }
    uint v = src.v[min(sy, sh - 1u) * spitch + min(sx, sw - 1u)];
    return cov >= 256u ? v : blend(v, c, cov);
}

// scene::panel at one pixel; `base` is the blurred pixel beneath.
uint panel(uint i, uint x, uint y, uint c) {
    uint dx = word(i, 1u), dy = word(i, 2u), dw = word(i, 3u), dh = word(i, 4u);
    Words src = Words(uint64_t(word(i, 5u)) | (uint64_t(word(i, 6u)) << 32));
    uint sw = word(i, 7u), sh = word(i, 8u), spitch = word(i, 9u);
    if (x < dx || y < dy || x >= dx + dw || y >= dy + dh || x >= dx + sw || y >= dy + sh)
        return c;
    uint pv = src.v[(y - dy) * spitch + (x - dx)];
    uint a = pv >> 24;
    if (a == 0u)
        return c;
    if (a < 255u) {
        uint base = c;
        if (p.bsw != 0u) {
            // background::blur_region's bilinear step.
            uint fy = (y >= 2u ? y - 2u : 0u) * 256u / 4u;
            uint gy = (fy >> 8) >= p.by0 ? (fy >> 8) - p.by0 : 0u;
            uint y0 = min(gy, p.bsh - 1u);
            uint wy = fy & 255u;
            uint y1 = min(y0 + 1u, p.bsh - 1u);
            uint fx = (x >= 2u ? x - 2u : 0u) * 256u / 4u;
            uint gx = (fx >> 8) >= p.bx0 ? (fx >> 8) - p.bx0 : 0u;
            uint x0 = min(gx, p.bsw - 1u);
            uint wx = fx & 255u;
            uint x1 = min(x0 + 1u, p.bsw - 1u);
            uint q00 = p.planes.v[y0 * p.bsw + x0];
            uint q01 = p.planes.v[y0 * p.bsw + x1];
            uint q10 = p.planes.v[y1 * p.bsw + x0];
            uint q11 = p.planes.v[y1 * p.bsw + x1];
            base = 0u;
            for (uint k = 0u; k < 3u; k++) {
                uint sh_ = 16u - 8u * k;
                uint top = ((q00 >> sh_) & 255u) * (256u - wx) + ((q01 >> sh_) & 255u) * wx;
                uint bot = ((q10 >> sh_) & 255u) * (256u - wx) + ((q11 >> sh_) & 255u) * wx;
                uint v = (top * (256u - wy) + bot * wy) >> 16;
                base |= min(v, 255u) << sh_;
            }
        }
        uint fill = ink_fill(pv & 0xFFFFFFu, p.frame.v[F_INK_TINT], p.frame.v[F_INK_TINT_W]);
        return glass_blend(fill, base, a, p.frame.v[F_INK_CEIL]);
    }
    return blend(pv & 0xFFFFFFu, c, a);
}

// scene::text at one pixel.
uint text(uint i, uint x, uint y, uint c) {
    uint dx = word(i, 1u), dy = word(i, 2u), dw = word(i, 3u), dh = word(i, 4u);
    Words src = Words(uint64_t(word(i, 5u)) | (uint64_t(word(i, 6u)) << 32));
    uint sw = word(i, 7u), sh = word(i, 8u), spitch = word(i, 9u);
    if (x < dx || y < dy || x >= dx + dw || y >= dy + dh || x >= dx + sw || y >= dy + sh)
        return c;
    uint pv = src.v[(y - dy) * spitch + (x - dx)];
    return (pv >> 24) != 0u ? pv & 0xFFFFFFu : c;
}

// Item::Fill at one pixel.
uint fill(uint i, uint x, uint y, uint c) {
    uint rx = word(i, 1u), ry = word(i, 2u), rw = word(i, 3u), rh = word(i, 4u);
    uint color = word(i, 5u), alpha = word(i, 6u), radius = word(i, 7u);
    if (alpha == 0u || x < rx || y < ry || x >= rx + rw || y >= ry + rh)
        return c;
    uint r = min(radius, min(rw / 2u, rh / 2u));
    uint cov = rect_coverage(x, y, rx, ry, rw, rh, r);
    if (cov == 0u)
        return c;
    uint a = min(min(alpha, 255u) * cov / 255u, 256u);
    if (a == 0u)
        return c;
    return a >= 256u ? color & 0xFFFFFFu : blend(color & 0xFFFFFFu, c, a);
}

// Item::CloseGlyph at one pixel.
uint close_glyph(uint i, uint x, uint y, uint c) {
    uint rx = word(i, 1u), ry = word(i, 2u), rw = word(i, 3u), rh = word(i, 4u);
    uint asz = word(i, 5u), color = word(i, 6u), off = word(i, 7u);
    if (x < rx || y < ry || x >= rx + rw || y >= ry + rh)
        return c;
    uint ox = rx + (rw >= asz ? rw - asz : 0u) / 2u;
    uint oy = ry + (rh >= asz ? rh - asz : 0u) / 2u;
    if (x < ox || y < oy || x >= ox + asz || y >= oy + asz)
        return c;
    uint b = off + (y - oy) * asz + (x - ox);
    uint a = (addr(F_GLYPHS).v[b >> 2] >> ((b & 3u) * 8u)) & 255u;
    if (a == 0u)
        return c;
    a += a >> 7;
    return a >= 256u ? color : blend(color, c, a);
}

void main() {
    uint gx = gl_GlobalInvocationID.x;
    uint gy = gl_GlobalInvocationID.y;
    if (gx >= p.clip_w || gy >= p.clip_h)
        return;
    uint x = p.clip_x + gx;
    uint y = p.clip_y + gy;
    Words target = addr(F_TARGET);
    uint at = y * p.frame.v[F_TARGET_PITCH] + x;
    uint c = target.v[at];
    for (uint n = 0u; n < p.count; n++) {
        uint i = p.first + n;
        switch (word(i, 0u)) {
        case 1u:
            if ((p.frame.v[F_FLAGS] & FLAG_WALL) != 0u)
                c = addr(F_WALL).v[y * p.frame.v[F_WALL_PITCH] + x];
            else
                c = 0xFF181820u;
            break;
        case 2u: c = glow(i, x, y, c); break;
        case 3u: c = glass_backdrop(i, x, y, c); break;
        case 4u: c = chrome(i, x, y, c); break;
        case 5u: c = content(i, x, y, c); break;
        case 6u: c = panel(i, x, y, c); break;
        case 7u: c = text(i, x, y, c); break;
        case 8u: c = fill(i, x, y, c); break;
        case 9u: c = close_glyph(i, x, y, c); break;
        default: break;
        }
    }
    target.v[at] = c;
}
